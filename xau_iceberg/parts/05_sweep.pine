// ============================================================================
//  SECTION 5 : LIQUIDITY SWEEP / STOP-RUN ENGINE
//
//  READ-ONLY over SECTION 4's array<LiquidityLevel>. This module does not own a
//  level registry, does not create levels, does not merge them and does not
//  mutate a single field on one. The architect's ruling is explicit: SECTION 4
//  owns the map, SECTION 5 owns the EVENT. So every value this engine needs from
//  a level - its price and its quality - is SNAPSHOTTED into a SweepCand at
//  candidate open. A later EQ merge in SECTION 4 can move lv.price by up to the
//  cluster tolerance; if the state machine kept reading lv.price live, the
//  penetration it is measuring would jump with no relation to what price did,
//  and a live candidate could flip to BROKEN on a bar where nothing happened.
//
//  WHAT A SWEEP IS HERE: price pushes BEYOND a known resting-liquidity level by
//  at least minPen (so a graze inside the spread is not an event) but by no more
//  than maxPen (deeper than that and it is a genuine breakout, not a stop-run),
//  and then CLOSES back through the level plus a buffer inside a window of
//  i_sweepBars bars. Every one of those three distances goes through f_tol(), so
//  none of them is denominated in ticks and none of them can collapse below the
//  spread in dead tape.
//
//  FROZEN AT CANDIDATE OPEN, and this is the whole non-drift argument:
//    * the level price          (a later merge cannot move the goalposts)
//    * the max-penetration ceil (ATR is an RMA and drifts ~7%/bar; a candidate
//                                opened under one ceiling must not be judged
//                                under another, or a quiet bar with NO new
//                                extreme can turn a live sweep into a breakout)
//    * the reclaim buffer       (same reason)
//    * the level quality        (SECTION 4 may re-score the level meanwhile)
//
//  DIRECTION: one code path, dir = +1 LONG / -1 SHORT. A LONG needs SELL-side
//  liquidity taken below a SUPPORT level, so the eligible level is lvl.side ==
//  -dir - which is what SECTION 4's f_s4Elig() tests, plus the two cases only it
//  can know about (a neutral level, and a level still inside its polarity-flip
//  grace window). probe/pen/beyond/reclaim are all written with the dir sign, so
//  the mirror is structural: there is no second block of arithmetic that can
//  drift out of step with this one.
//
//  i_sweepRearmBars is a PER-LEVEL re-arm, NOT a global cooldown. Global
//  cooldowns belong to SECTION 13, are per-direction there, and mean something
//  different: this one stops ONE price pocket machine-gunning a candidate every
//  bar; that one stops the SYSTEM trading after a loss.
// ============================================================================

G5 = "5 - Liquidity Sweep"

// ------------------------------------------------------------- 5.1 INPUTS
i_sweepMinPen = input.float(0.12, "Min penetration (x ATR, floored at spread)",
     minval = 0.0, maxval = 2.0, step = 0.01, group = G5,
     tooltip = "Smallest push beyond a level that counts as a stop-run. It is " +
               "f_tol()'d, so the effective floor is never below one spread - on " +
               "1M gold that floor, not ATR, is what keeps quote noise out. At 0 " +
               "the spread floor still applies; raise it and only decisive raids " +
               "register, at the cost of missing shallow surgical sweeps.",
     display = display.none)
i_sweepMaxPen = input.float(0.90, "Max penetration (x ATR, floored at spread)",
     minval = 0.1, maxval = 5.0, step = 0.05, group = G5,
     tooltip = "Deepest push still treated as a SWEEP. Beyond this, a bar that " +
               "also CLOSES beyond the level is reclassified as a genuine " +
               "breakout and the candidate is dropped. A deep push that closes " +
               "back inside is NOT reclassified - that is the violent NFP-style " +
               "stop-run, and it still resolves as a sweep with a depth score of " +
               "zero. Too low and every ordinary range bar looks like a breakout; " +
               "too high and real trend breaks are mislabelled reversals. The " +
               "band is auto-widened if it would invert against min penetration.",
     display = display.none)
i_sweepBuf = input.float(0.10, "Reclaim buffer (x ATR, floored at spread)",
     minval = 0.0, maxval = 1.0, step = 0.01, group = G5,
     tooltip = "How far back THROUGH the level the reclaiming close must sit. " +
               "Stops a close resting exactly on the level from counting as a " +
               "reclaim. At 0 the spread floor still applies; raising it demands " +
               "a more decisive rejection and produces fewer, later sweeps.",
     display = display.none)
i_sweepBars = input.int(3, "Reclaim window (bars)", minval = 1, maxval = 20, group = G5,
     tooltip = "Bars allowed for the reclaiming close, COUNTING the penetration " +
               "bar itself. 1 = same-bar sweep and reclaim only. Every candidate " +
               "is fully resolved within this many bars - there is no state that " +
               "lingers. Larger windows catch multi-bar raids but publish later, " +
               "and the reclaim-speed part of the quality score then means less.",
     display = display.none)
i_sweepAccept = input.int(2, "Acceptance closes = breakout", minval = 1, maxval = 10,
     group = G5,
     tooltip = "Closes BEYOND the level, inside the window, that reclassify the " +
               "candidate as acceptance rather than a raid. 1 = strict: the " +
               "penetration bar must close back. Higher values tolerate more " +
               "closes beyond before giving up, which admits slower reversals " +
               "and also more failed breaks pretending to be sweeps.",
     display = display.none)
i_sweepRearmBars = input.int(10, "Per-level re-arm (bars)", minval = 0, maxval = 500,
     group = G5,
     tooltip = "After a level's candidate resolves - swept, broken or expired - " +
               "that PRICE POCKET cannot open another candidate for this many " +
               "bars. This is a per-level de-duplication, NOT the system cooldown " +
               "(SECTION 13 owns that, per direction). At 0 a level that stays " +
               "penetrated can re-arm every bar.",
     display = display.none)
i_sweepMinQual = input.float(0.45, "Min sweep quality to publish (0..1)",
     minval = 0.0, maxval = 1.0, step = 0.01, group = G5,
     tooltip = "Sweeps scoring below this are detected but not published - the " +
               "liquidity is still consumed and the level still re-arms, but the " +
               "chain never starts. This is a SETUP QUALITY score, never a win " +
               "probability. At 0 every reclaim publishes, which is the definition " +
               "of the event rather than evidence about it; at 1 nothing ever does.",
     display = display.none)

// --------------------------------------------------- 5.2 SCORE CONSTANTS
// Weights sum to 1.00 and qSweep is exported in [0,1] - SECTION 12 owns the one
// 0-100 score in this file, so nothing here mints points.
//
// The weighting answers a specific criticism: reclaim SPEED and the rejection
// WICK partly encode the same fact (a same-bar reclaim IS a big wick), and both
// are implied by the confirmation condition itself. So speed is the SMALLEST
// term, the wick and the participation proxy carry the independent evidence, and
// the floor for "it poked out and closed back in" on a lone untested swing with
// no volume and no wick is 0.427 - below the default publish gate. The gate can
// therefore only be cleared by evidence the trigger did not already guarantee.
SWQ_W_DEPTH = 0.20
SWQ_W_SPEED = 0.15
SWQ_W_PART  = 0.20
SWQ_W_WICK  = 0.25
SWQ_W_LEVEL = 0.20
// Depth is a HUMP, not a ramp. A one-spread graze sits at the noise floor and a
// push that nearly reached the breakout boundary was nearly a breakout; the good
// raid is in between. A pure "shallower is better" ramp makes the threshold that
// exists to exclude noise and the threshold that maximises score the same number.
SWQ_D_LO = 0.20
SWQ_D_HI = 0.55

// ------------------------------------------------- 5.3 PER-BAR THRESHOLDS
// Every distance through f_tol(): nothing here is in ticks, and nothing can sit
// below the spread. The band is clamped so it can NEVER invert - an inverted band
// is silently catastrophic, because every touch then routes to "breakout" and the
// engine emits zero sweeps forever while shredding the level map.
swpMinPen = f_tol(i_sweepMinPen)
swpCeil   = math.max(f_tol(i_sweepMaxPen), swpMinPen * 2.0)
swpBufNow = f_tol(i_sweepBuf)
// Pocket tolerance: two levels closer together than this are ONE pocket of
// liquidity for de-duplication purposes, so a wick through both cannot publish
// twice from the same stop cluster.
swpPocket = f_tol(0.10)

// -------------------------------------------------------- 5.4 ENGINE STATE
// Open candidates plus three LOCKSTEP side-cars. SweepCand (SECTION 1) has no
// field for the bar statistics, the frozen buffer or the acceptance counter, and
// SECTION 1 is frozen, so they live in parallel arrays that are only ever pushed
// and removed through f_sweepAdd() / f_sweepDrop(). Nothing else may touch them.
var array<SweepCand> swpCands = array.new<SweepCand>()
var array<float>     swpEvid  = array.new<float>()   // extreme-bar evidence, 0..1
var array<float>     swpBuf   = array.new<float>()   // reclaim buffer frozen at open
var array<int>       swpAcc   = array.new<int>()     // closes beyond the level so far

// Per-level re-arm memory, keyed by the PRICE POCKET rather than by an array
// index (SECTION 4 prunes and re-orders its array, so an index is not an
// identity) and rather than by the level object (which may be deleted).
var array<float> swpArmPx  = array.new<float>()
var array<int>   swpArmDir = array.new<int>()
var array<int>   swpArmBar = array.new<int>()

// ------------------------------------------------------------ 5.5 EXPORTS
// VAR, not per-bar locals. SECTION 7 reads sweepLvl* as the rejection edge and
// SECTION 11 reads sweepExt* as a stop anchor, both on bars AFTER the sweep bar.
// A non-var local would be na on every one of those bars, every comparison
// against it would silently be false, and the chain would never fire.
var bool  sweepSigL = false
var bool  sweepSigS = false
var float sweepExtL = na      // the wick tip of a SELL-side raid: the natural stop
var float sweepExtS = na      // the wick tip of a BUY-side raid
var float sweepLvlL = na      // the level that was swept: the invalidation reference
var float sweepLvlS = na
var float qSweepL   = 0.0     // 0..1 setup evidence for SECTION 12's rubric
var float qSweepS   = 0.0
var int   sweepBarL = na      // bar of the last published sweep - STALENESS lives
var int   sweepBarS = na      // downstream (SECTION 14 owns phase deadlines)

// ----------------------------------------------------- 5.6 DIR PRIMITIVES
// The entire mirror, in four lines. dir = +1 probes the LOW against a support
// level; dir = -1 probes the HIGH against a resistance level. Reflect the chart
// vertically and every one of these maps onto its opposite exactly.
f_sweepProbe(int dir)                       => dir > 0 ? low : high
f_sweepPen(int dir, float lvlPx)            => dir * (lvlPx - f_sweepProbe(dir))
f_sweepBeyond(int dir, float lvlPx)         => dir * (lvlPx - close) > 0.0
f_sweepRecl(int dir, float lvlPx, float bf) => dir * (close - lvlPx) > bf

// The level's contribution to the sweep score. SECTION 4 keeps lv.strength as
// the LIVE quality - SECTION 2's kind x touches rubric, aged from the last touch
// and discounted once a polarity flip is out of its grace window - so it is a
// strictly better number than the raw rubric. The fallback covers a level that
// has not been scored yet, which would otherwise zero the whole row.
f_sweepLvlQ(LiquidityLevel lv) =>
    float s = f_clamp01(nz(lv.strength, 0.0))
    s > 0.0 ? s : f_clamp01(lv.quality())

// Bar evidence, latched on the bar that sets the extreme and never re-latched by
// a later inside bar - the statistics of the real stop-run bar must survive.
// rvol is na on a feed without volume: the participation row is then DROPPED and
// the wick row carries the whole sub-block, which is this file's one na policy
// (never 0 - that would make a missing feed a permanent penalty; never 1 - that
// would fabricate participation out of nothing).
f_sweepEvid(int dir) =>
    float wk = nz(f_ramp(f_wickFrac(dir), 0.30, 0.70), 0.0)
    float pt = f_ramp(rvol, 1.0, 2.0)
    na(pt) ? wk : (SWQ_W_PART * pt + SWQ_W_WICK * wk) / (SWQ_W_PART + SWQ_W_WICK)

// The 0..1 sweep quality. pen and ceil are BOTH the frozen candidate values, so
// identical price action always scores identically no matter how ATR drifted
// during the window.
f_sweepQual(float pen, float ceil, int lag, float evid, float lvlQ) =>
    float d    = ceil > 0.0 ? f_clamp01(pen / ceil) : 1.0
    float dUp  = nz(f_ramp(d, 0.0, SWQ_D_LO), 0.0)          // rises to the hump
    float dDn  = nz(f_ramp(-d, -1.0, -SWQ_D_HI), 0.0)       // falls off the hump
    float dep  = math.min(dUp, dDn)
    float spd  = nz(f_ramp(float(i_sweepBars - lag), 0.0, float(i_sweepBars)), 0.0)
    f_clamp01(SWQ_W_DEPTH * dep + SWQ_W_SPEED * spd +
              (SWQ_W_PART + SWQ_W_WICK) * nz(evid, 0.0) +
              SWQ_W_LEVEL * f_clamp01(nz(lvlQ, 0.0)))

// ------------------------------------------------ 5.7 LOCKSTEP REGISTRIES
// The four candidate arrays are index-aligned by construction: they are ONLY
// grown and shrunk here, together, so no caller can desynchronise them.
f_sweepAdd(SweepCand c, float evid, float bf, int acc) =>
    array.push(swpCands, c)
    array.push(swpEvid, evid)
    array.push(swpBuf, bf)
    array.push(swpAcc, acc)

f_sweepDrop(int i) =>
    array.remove(swpCands, i)
    array.remove(swpEvid, i)
    array.remove(swpBuf, i)
    array.remove(swpAcc, i)

// Record (or refresh) the re-arm clock for a price pocket.
f_sweepRearm(int dir, float px) =>
    bool found = false
    int  n     = array.size(swpArmPx)
    if n > 0
        for i = 0 to n - 1
            if array.get(swpArmDir, i) == dir and
               math.abs(array.get(swpArmPx, i) - px) <= swpPocket
                array.set(swpArmPx, i, px)
                array.set(swpArmBar, i, bar_index)
                found := true
    if not found
        array.push(swpArmPx, px)
        array.push(swpArmDir, dir)
        array.push(swpArmBar, bar_index)

// Is this pocket allowed to open a candidate at all?
f_sweepArmed(int dir, float px) =>
    bool ok = true
    int  n  = array.size(swpArmPx)
    if n > 0
        for i = 0 to n - 1
            if array.get(swpArmDir, i) == dir and
               math.abs(array.get(swpArmPx, i) - px) <= swpPocket and
               bar_index - array.get(swpArmBar, i) < i_sweepRearmBars
                ok := false
    ok

// One candidate per pocket at a time. Without this, two swing lows 0.25 USD
// apart are two objects, one wick opens both, and the second publishes on the
// next bar from the same stop cluster.
f_sweepHasCand(int dir, float px) =>
    bool hit = false
    for c in swpCands
        if c.dir == dir and math.abs(c.lvlPrice - px) <= swpPocket
            hit := true
    hit

// Drop re-arm records that can no longer block anything. Walks DOWN so a removal
// never disturbs an index still to be visited.
f_sweepPrune() =>
    int n = array.size(swpArmPx)
    if n > 0
        for i = n - 1 to 0
            if bar_index - array.get(swpArmBar, i) >= i_sweepRearmBars
                array.remove(swpArmPx, i)
                array.remove(swpArmDir, i)
                array.remove(swpArmBar, i)

// ------------------------------------------------- 5.8 THE STATE MACHINE
// ONE function, called once per direction. It mutates arrays and object fields
// (both legal inside a Pine function) and returns its result as a tuple, because
// assigning to a global inside a function is a hard compile error in v6.
//
// Returns [fired, sweptLevel, sweepExtreme, quality] for the best-scoring sweep
// on this side this bar - at most ONE publish per side per bar.
f_sweepRun(int dir) =>
    bool  fired = false
    float bLvl  = na
    float bExt  = na
    float bQ    = 0.0

    // --- A. advance every OPEN candidate on this side ----------------------
    // Descending walk: f_sweepDrop() removes the entry we are standing on, and
    // walking down guarantees that only already-visited indices shift.
    int n = array.size(swpCands)
    if n > 0
        for i = n - 1 to 0
            SweepCand c = array.get(swpCands, i)
            if c.dir == dir
                float bf   = array.get(swpBuf, i)
                float pen  = f_sweepPen(dir, c.lvlPrice)
                float pMax = dir * (c.lvlPrice - c.extreme)   // the RATCHET, derived
                bool  bey  = f_sweepBeyond(dir, c.lvlPrice)
                bool  rec  = f_sweepRecl(dir, c.lvlPrice, bf)
                // New extreme: re-latch the bar statistics onto THIS bar. An
                // inside bar never overwrites the stats of the real raid bar.
                if pen > pMax
                    c.extreme := f_sweepProbe(dir)
                    array.set(swpEvid, i, f_sweepEvid(dir))
                    pMax := pen
                if bey
                    array.set(swpAcc, i, array.get(swpAcc, i) + 1)
                int  lag  = bar_index - c.openBar
                bool last = lag >= i_sweepBars - 1     // the LAST bar of the window
                bool deep = pMax > c.maxPen            // ceiling FROZEN at open
                if deep and bey
                    // Too deep AND accepted beyond: a genuine breakout. The close
                    // is what decides - a 3-ATR spike that closed back inside is
                    // the most characteristic gold stop-run there is, and calling
                    // that a breakout would delete the level it just raided.
                    f_sweepRearm(dir, c.lvlPrice)
                    f_sweepDrop(i)
                else if array.get(swpAcc, i) >= i_sweepAccept
                    // Acceptance beyond the level: the market took it, not a raid.
                    f_sweepRearm(dir, c.lvlPrice)
                    f_sweepDrop(i)
                else if rec and lag <= i_sweepBars - 1
                    // SWEPT. A deep-but-reclaimed raid lands here too and scores
                    // ~0 on depth, which is the honest outcome rather than a veto.
                    float q = f_sweepQual(pMax, c.maxPen, lag, array.get(swpEvid, i),
                         c.quality)
                    if q >= i_sweepMinQual and q > bQ
                        fired := true
                        bQ    := q
                        bLvl  := c.lvlPrice
                        bExt  := c.extreme
                    f_sweepRearm(dir, c.lvlPrice)
                    f_sweepDrop(i)
                else if last
                    // Window over with no reclaim. Nothing lingers unresolved.
                    f_sweepRearm(dir, c.lvlPrice)
                    f_sweepDrop(i)

    // --- B. open NEW candidates against SECTION 4's map (read-only) --------
    int m = array.size(levels)
    if m > 0
        for j = 0 to m - 1
            LiquidityLevel lv = array.get(levels, j)
            // f_s4Elig() is SECTION 4's eligibility test and the only one used
            // here. It is a superset of SECTION 2's strict isFor(): besides
            // "active, priced, born from the opposite polarity", it admits a
            // neutral level and - critically - a level still inside its flip
            // grace window. That last case IS the setup: a close below PDL is
            // what flips PDL from support to resistance, and testing isFor()
            // alone would disqualify the level on the exact bar its sweep
            // becomes tradeable.
            if f_s4Elig(lv, dir)
                float lp  = lv.price
                float pen = f_sweepPen(dir, lp)
                if pen >= swpMinPen
                    bool free = not f_sweepHasCand(dir, lp)
                    bool arm  = f_sweepArmed(dir, lp)
                    if free and arm
                        bool bey = f_sweepBeyond(dir, lp)
                        bool rec = f_sweepRecl(dir, lp, swpBufNow)
                        if pen > swpCeil and bey
                            // Born already broken: a breakout, never a candidate.
                            f_sweepRearm(dir, lp)
                        else
                            // SNAPSHOT EVERYTHING. From here on this candidate is
                            // judged against the numbers that existed when it
                            // opened, not against whatever ATR or SECTION 4 do next.
                            float ev = f_sweepEvid(dir)
                            if rec
                                // Same-bar raid and reclaim: lag 0, resolved now.
                                float q = f_sweepQual(pen, swpCeil, 0, ev, f_sweepLvlQ(lv))
                                if q >= i_sweepMinQual and q > bQ
                                    fired := true
                                    bQ    := q
                                    bLvl  := lp
                                    bExt  := f_sweepProbe(dir)
                                f_sweepRearm(dir, lp)
                            else if i_sweepBars <= 1
                                // One-bar window, already closed unreclaimed.
                                f_sweepRearm(dir, lp)
                            else
                                f_sweepAdd(SweepCand.new(dir = dir, lvlPrice = lp,
                                     extreme = f_sweepProbe(dir), openBar = bar_index,
                                     lvlIdx = j, maxPen = swpCeil,
                                     quality = f_sweepLvlQ(lv), resolved = false),
                                     ev, swpBufNow, bey ? 1 : 0)
    [fired, bLvl, bExt, bQ]

// --------------------------------------------------------- 5.9 PER-BAR RUN
// Confirmed bars only. Nothing above this line mutated anything.
if confirmed and warmupOk
    sweepSigL := false
    sweepSigS := false
    f_sweepPrune()

    // Both directions are advanced by the SAME function. There is no long block
    // and short block to keep in sync - there is one block, called twice.
    [fL, lvL, exL, qL] = f_sweepRun(1)
    [fS, lvS, exS, qS] = f_sweepRun(-1)

    if fL
        sweepSigL := true
        sweepLvlL := lvL
        sweepExtL := exL
        qSweepL   := qL
        sweepBarL := bar_index
    if fS
        sweepSigS := true
        sweepLvlS := lvS
        sweepExtS := exS
        qSweepS   := qS
        sweepBarS := bar_index
// The latched values deliberately OUTLIVE their bar: the chain that consumes them
// (rejection -> absorption -> displacement -> BOS -> retest) runs over the bars
// AFTER the sweep. Judging whether a latched sweep is too old to still count is
// SECTION 14's job, which is why sweepBarL/S is exported alongside them.
// ========================= END SECTION 5 ====================================
