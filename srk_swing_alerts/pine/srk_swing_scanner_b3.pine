//@version=6
// =============================================================================
//  SRK Swing Scanner - batch 3 of 6   (40 symbols, 15m timeframe)
//
//  One script watches 40 F&O underlyings at once and raises a SINGLE
//  TradingView alert naming whichever of them just gave a signal. Pine caps a
//  script at 40 request.security() calls, which is why the F&O list is split
//  across several scripts.
//
//  Signal (the SRK Trading Swing rule, on CLOSED 15m candles):
//    BULLISH  EMA stack flips to Red > Green > Blue  AND  ADX(14) > 20
//    BEARISH  EMA stack flips to Blue > Green > Red  AND  ADX(14) > 20
//    SL       low of the candle before the flip (bullish) / its high (bearish)
//
//  Setup: add to a 15m chart -> Alert -> Condition = this script ->
//         "Any alert() function call" -> tick Show popup + Play sound -> Create.
//  Generated by generate_scanners.py - edit that, not this file.
// =============================================================================
indicator("SRK Swing Scanner B3 (15m)", overlay = true, max_labels_count = 500)

// ---------------------------- Signal settings -------------------------------
tf      = input.timeframe("15", "Scan timeframe", group = "Signal")
fastLen = input.int(5,    "Red EMA (fast)",  minval = 1, group = "Signal")
midLen  = input.int(10,   "Green EMA (mid)", minval = 1, group = "Signal")
slowLen = input.int(20,   "Blue EMA (slow)", minval = 1, group = "Signal")
adxLen  = input.int(14,   "ADX length",      minval = 1, group = "Signal")
adxThr  = input.float(20, "ADX threshold",   group = "Signal")

// ---------------------------- Noise filters ---------------------------------
// Measured on b1 (the 40 busiest F&O names) over a real session:
//   defaults below (loose flip, ADX>20) ....... ~13 alerts/day
//   + ADX 25 or 30 ............................. ~4 alerts/day
//   + "Require a flip from the opposite stack" .. ~2 alerts/day
// The last of those matches how rarely the SRK indicator plots a triangle, but
// it is too quiet to be useful as an ALERT - a whole session can pass with one
// signal, fired at 09:15. Start here and tighten only if the flow is too noisy.
alternateOnly   = input.bool(true, "Only alternate signals (no repeat in same direction)", group = "Noise filters")
requireOpposite = input.bool(false, "Require a flip straight from the opposite stack", group = "Noise filters")
cooldownBars    = input.int(0, "Minimum bars between signals", minval = 0, group = "Noise filters")

// ---------------------------- Display settings ------------------------------
showPanel = input.bool(true, "Show scanner panel", group = "Display")
panelPos  = input.string("Top right", "Panel position", group = "Display",
     options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"])
onlyHits  = input.bool(false, "Panel: only symbols signalling right now", group = "Display")
markChart = input.bool(true,  "Draw signals on this chart's own symbol", group = "Display")

// ---------------------------- The SRK swing rule ----------------------------
// Runs once per symbol, inside that symbol's own context via request.security.
srk() =>
    r = ta.ema(close, fastLen)
    g = ta.ema(close, midLen)
    b = ta.ema(close, slowLen)
    [_diP, _diM, adxv] = ta.dmi(adxLen, adxLen)
    up = r > g and g > b                       // RGB: red on top
    dn = b > g and g > r                       // BGR: blue on top
    state = up ? 1 : dn ? -1 : 0
    flip  = state != 0 and state != state[1]   // first bar the stack aligns
    raw   = flip and adxv > adxThr and (not requireOpposite or state[1] == -state)

    // Kept per symbol, because "have we already signalled this swing?" is a
    // per-symbol question and request.security runs this in each one's context.
    var int lastDir = 0
    var int lastBar = -1000000
    fire = raw and (not alternateOnly or state != lastDir) and (bar_index - lastBar >= cooldownBars)
    if fire
        lastDir := state
        lastBar := bar_index

    sig = fire ? state : 0
    sl  = not fire ? na : state == 1 ? low[1] : high[1]
    [sig, state, close, adxv, sl]

// Strip the exchange prefix so alerts read "RELIANCE", not "NSE:RELIANCE".
shortName(s) => str.replace_all(str.replace_all(s, "NSE:", ""), "BSE:", "")

// ---------------------------- Scanned symbols -------------------------------

sym01 = input.symbol("NSE:POLICYBZR", "01", group = "Symbols 1-20")
sym02 = input.symbol("NSE:KEI", "02", group = "Symbols 1-20")
sym03 = input.symbol("NSE:CGPOWER", "03", group = "Symbols 1-20")
sym04 = input.symbol("NSE:ICICIGI", "04", group = "Symbols 1-20")
sym05 = input.symbol("NSE:DMART", "05", group = "Symbols 1-20")
sym06 = input.symbol("NSE:BANKBARODA", "06", group = "Symbols 1-20")
sym07 = input.symbol("NSE:BHARATFORG", "07", group = "Symbols 1-20")
sym08 = input.symbol("NSE:NAM_INDIA", "08", group = "Symbols 1-20")
sym09 = input.symbol("NSE:MANAPPURAM", "09", group = "Symbols 1-20")
sym10 = input.symbol("NSE:NESTLEIND", "10", group = "Symbols 1-20")
sym11 = input.symbol("NSE:NATIONALUM", "11", group = "Symbols 1-20")
sym12 = input.symbol("NSE:DLF", "12", group = "Symbols 1-20")
sym13 = input.symbol("NSE:SIEMENS", "13", group = "Symbols 1-20")
sym14 = input.symbol("NSE:LODHA", "14", group = "Symbols 1-20")
sym15 = input.symbol("NSE:MOTHERSON", "15", group = "Symbols 1-20")
sym16 = input.symbol("NSE:CHOLAFIN", "16", group = "Symbols 1-20")
sym17 = input.symbol("NSE:ANGELONE", "17", group = "Symbols 1-20")
sym18 = input.symbol("NSE:TRENT", "18", group = "Symbols 1-20")
sym19 = input.symbol("NSE:AMBER", "19", group = "Symbols 1-20")
sym20 = input.symbol("NSE:AUBANK", "20", group = "Symbols 1-20")
sym21 = input.symbol("NSE:MAZDOCK", "21", group = "Symbols 21-40")
sym22 = input.symbol("NSE:BPCL", "22", group = "Symbols 21-40")
sym23 = input.symbol("NSE:HYUNDAI", "23", group = "Symbols 21-40")
sym24 = input.symbol("NSE:BOSCHLTD", "24", group = "Symbols 21-40")
sym25 = input.symbol("NSE:INDUSTOWER", "25", group = "Symbols 21-40")
sym26 = input.symbol("NSE:APLAPOLLO", "26", group = "Symbols 21-40")
sym27 = input.symbol("NSE:LUPIN", "27", group = "Symbols 21-40")
sym28 = input.symbol("NSE:RECLTD", "28", group = "Symbols 21-40")
sym29 = input.symbol("NSE:WIPRO", "29", group = "Symbols 21-40")
sym30 = input.symbol("NSE:NAUKRI", "30", group = "Symbols 21-40")
sym31 = input.symbol("NSE:SUZLON", "31", group = "Symbols 21-40")
sym32 = input.symbol("NSE:LTM", "32", group = "Symbols 21-40")
sym33 = input.symbol("NSE:BRITANNIA", "33", group = "Symbols 21-40")
sym34 = input.symbol("NSE:MAXHEALTH", "34", group = "Symbols 21-40")
sym35 = input.symbol("NSE:BDL", "35", group = "Symbols 21-40")
sym36 = input.symbol("NSE:ZYDUSLIFE", "36", group = "Symbols 21-40")
sym37 = input.symbol("NSE:MARICO", "37", group = "Symbols 21-40")
sym38 = input.symbol("NSE:UNIONBANK", "38", group = "Symbols 21-40")
sym39 = input.symbol("NSE:HINDPETRO", "39", group = "Symbols 21-40")
sym40 = input.symbol("NSE:GODREJCP", "40", group = "Symbols 21-40")

[sg01, st01, px01, ad01, sl01] = request.security(sym01, tf, srk(), lookahead = barmerge.lookahead_off)
[sg02, st02, px02, ad02, sl02] = request.security(sym02, tf, srk(), lookahead = barmerge.lookahead_off)
[sg03, st03, px03, ad03, sl03] = request.security(sym03, tf, srk(), lookahead = barmerge.lookahead_off)
[sg04, st04, px04, ad04, sl04] = request.security(sym04, tf, srk(), lookahead = barmerge.lookahead_off)
[sg05, st05, px05, ad05, sl05] = request.security(sym05, tf, srk(), lookahead = barmerge.lookahead_off)
[sg06, st06, px06, ad06, sl06] = request.security(sym06, tf, srk(), lookahead = barmerge.lookahead_off)
[sg07, st07, px07, ad07, sl07] = request.security(sym07, tf, srk(), lookahead = barmerge.lookahead_off)
[sg08, st08, px08, ad08, sl08] = request.security(sym08, tf, srk(), lookahead = barmerge.lookahead_off)
[sg09, st09, px09, ad09, sl09] = request.security(sym09, tf, srk(), lookahead = barmerge.lookahead_off)
[sg10, st10, px10, ad10, sl10] = request.security(sym10, tf, srk(), lookahead = barmerge.lookahead_off)
[sg11, st11, px11, ad11, sl11] = request.security(sym11, tf, srk(), lookahead = barmerge.lookahead_off)
[sg12, st12, px12, ad12, sl12] = request.security(sym12, tf, srk(), lookahead = barmerge.lookahead_off)
[sg13, st13, px13, ad13, sl13] = request.security(sym13, tf, srk(), lookahead = barmerge.lookahead_off)
[sg14, st14, px14, ad14, sl14] = request.security(sym14, tf, srk(), lookahead = barmerge.lookahead_off)
[sg15, st15, px15, ad15, sl15] = request.security(sym15, tf, srk(), lookahead = barmerge.lookahead_off)
[sg16, st16, px16, ad16, sl16] = request.security(sym16, tf, srk(), lookahead = barmerge.lookahead_off)
[sg17, st17, px17, ad17, sl17] = request.security(sym17, tf, srk(), lookahead = barmerge.lookahead_off)
[sg18, st18, px18, ad18, sl18] = request.security(sym18, tf, srk(), lookahead = barmerge.lookahead_off)
[sg19, st19, px19, ad19, sl19] = request.security(sym19, tf, srk(), lookahead = barmerge.lookahead_off)
[sg20, st20, px20, ad20, sl20] = request.security(sym20, tf, srk(), lookahead = barmerge.lookahead_off)
[sg21, st21, px21, ad21, sl21] = request.security(sym21, tf, srk(), lookahead = barmerge.lookahead_off)
[sg22, st22, px22, ad22, sl22] = request.security(sym22, tf, srk(), lookahead = barmerge.lookahead_off)
[sg23, st23, px23, ad23, sl23] = request.security(sym23, tf, srk(), lookahead = barmerge.lookahead_off)
[sg24, st24, px24, ad24, sl24] = request.security(sym24, tf, srk(), lookahead = barmerge.lookahead_off)
[sg25, st25, px25, ad25, sl25] = request.security(sym25, tf, srk(), lookahead = barmerge.lookahead_off)
[sg26, st26, px26, ad26, sl26] = request.security(sym26, tf, srk(), lookahead = barmerge.lookahead_off)
[sg27, st27, px27, ad27, sl27] = request.security(sym27, tf, srk(), lookahead = barmerge.lookahead_off)
[sg28, st28, px28, ad28, sl28] = request.security(sym28, tf, srk(), lookahead = barmerge.lookahead_off)
[sg29, st29, px29, ad29, sl29] = request.security(sym29, tf, srk(), lookahead = barmerge.lookahead_off)
[sg30, st30, px30, ad30, sl30] = request.security(sym30, tf, srk(), lookahead = barmerge.lookahead_off)
[sg31, st31, px31, ad31, sl31] = request.security(sym31, tf, srk(), lookahead = barmerge.lookahead_off)
[sg32, st32, px32, ad32, sl32] = request.security(sym32, tf, srk(), lookahead = barmerge.lookahead_off)
[sg33, st33, px33, ad33, sl33] = request.security(sym33, tf, srk(), lookahead = barmerge.lookahead_off)
[sg34, st34, px34, ad34, sl34] = request.security(sym34, tf, srk(), lookahead = barmerge.lookahead_off)
[sg35, st35, px35, ad35, sl35] = request.security(sym35, tf, srk(), lookahead = barmerge.lookahead_off)
[sg36, st36, px36, ad36, sl36] = request.security(sym36, tf, srk(), lookahead = barmerge.lookahead_off)
[sg37, st37, px37, ad37, sl37] = request.security(sym37, tf, srk(), lookahead = barmerge.lookahead_off)
[sg38, st38, px38, ad38, sl38] = request.security(sym38, tf, srk(), lookahead = barmerge.lookahead_off)
[sg39, st39, px39, ad39, sl39] = request.security(sym39, tf, srk(), lookahead = barmerge.lookahead_off)
[sg40, st40, px40, ad40, sl40] = request.security(sym40, tf, srk(), lookahead = barmerge.lookahead_off)

// ---------------------------- Collect the batch -----------------------------
names  = array.from(shortName(sym01), shortName(sym02), shortName(sym03), shortName(sym04), shortName(sym05),
     shortName(sym06), shortName(sym07), shortName(sym08), shortName(sym09),
     shortName(sym10), shortName(sym11), shortName(sym12), shortName(sym13),
     shortName(sym14), shortName(sym15), shortName(sym16), shortName(sym17),
     shortName(sym18), shortName(sym19), shortName(sym20), shortName(sym21),
     shortName(sym22), shortName(sym23), shortName(sym24), shortName(sym25),
     shortName(sym26), shortName(sym27), shortName(sym28), shortName(sym29),
     shortName(sym30), shortName(sym31), shortName(sym32), shortName(sym33),
     shortName(sym34), shortName(sym35), shortName(sym36), shortName(sym37),
     shortName(sym38), shortName(sym39), shortName(sym40))
sigs   = array.from(sg01, sg02, sg03, sg04, sg05, sg06, sg07, sg08, sg09, sg10, sg11, sg12, sg13, sg14, sg15,
     sg16, sg17, sg18, sg19, sg20, sg21, sg22, sg23, sg24, sg25, sg26, sg27, sg28, sg29,
     sg30, sg31, sg32, sg33, sg34, sg35, sg36, sg37, sg38, sg39, sg40)
states = array.from(st01, st02, st03, st04, st05, st06, st07, st08, st09, st10, st11, st12, st13, st14, st15,
     st16, st17, st18, st19, st20, st21, st22, st23, st24, st25, st26, st27, st28, st29,
     st30, st31, st32, st33, st34, st35, st36, st37, st38, st39, st40)
prices = array.from(px01, px02, px03, px04, px05, px06, px07, px08, px09, px10, px11, px12, px13, px14, px15,
     px16, px17, px18, px19, px20, px21, px22, px23, px24, px25, px26, px27, px28, px29,
     px30, px31, px32, px33, px34, px35, px36, px37, px38, px39, px40)
adxs   = array.from(ad01, ad02, ad03, ad04, ad05, ad06, ad07, ad08, ad09, ad10, ad11, ad12, ad13, ad14, ad15,
     ad16, ad17, ad18, ad19, ad20, ad21, ad22, ad23, ad24, ad25, ad26, ad27, ad28, ad29,
     ad30, ad31, ad32, ad33, ad34, ad35, ad36, ad37, ad38, ad39, ad40)
sls    = array.from(sl01, sl02, sl03, sl04, sl05, sl06, sl07, sl08, sl09, sl10, sl11, sl12, sl13, sl14, sl15,
     sl16, sl17, sl18, sl19, sl20, sl21, sl22, sl23, sl24, sl25, sl26, sl27, sl28, sl29,
     sl30, sl31, sl32, sl33, sl34, sl35, sl36, sl37, sl38, sl39, sl40)

// ---------------------------- Alert -----------------------------------------
// One alert() call carries every symbol that fired on this bar, so a single
// TradingView alert covers all 40 of them.
msg  = ""
hits = 0
for i = 0 to array.size(names) - 1
    sg = array.get(sigs, i)
    if sg != 0
        hits += 1
        msg := msg + (msg == "" ? "" : "\n") + (sg == 1 ? "BULLISH  " : "BEARISH  ") + array.get(names, i) + "  @ " + str.tostring(array.get(prices, i), "#.##") + "  | SL " + str.tostring(array.get(sls, i), "#.##") + "  | ADX " + str.tostring(array.get(adxs, i), "#.0")

if hits > 0 and barstate.isconfirmed
    alert("SRK Swing " + tf + "m - " + str.tostring(hits) + " signal(s)\n" + msg, alert.freq_once_per_bar_close)

// ---------------------------- On-chart panel --------------------------------
// The scanner's own window: dim green/red = trend stack, bright = fired on this
// bar. This is what makes a hit visible without leaving the chart.
pos = panelPos == "Top left" ? position.top_left : panelPos == "Bottom right" ? position.bottom_right : panelPos == "Bottom left" ? position.bottom_left : panelPos == "Middle right" ? position.middle_right : position.top_right

var table panel = table.new(pos, 5, 41, border_width = 1)

if showPanel and barstate.islast
    table.clear(panel, 0, 0, 4, 40)
    hdrBg = color.new(color.gray, 20)
    table.cell(panel, 0, 0, "B3",  text_color = color.white, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(panel, 1, 0, "SYMBOL", text_color = color.white, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(panel, 2, 0, "TREND",  text_color = color.white, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(panel, 3, 0, "LTP",    text_color = color.white, bgcolor = hdrBg, text_size = size.tiny)
    table.cell(panel, 4, 0, "ADX",    text_color = color.white, bgcolor = hdrBg, text_size = size.tiny)
    row = 1
    for i = 0 to array.size(names) - 1
        sg = array.get(sigs, i)
        st = array.get(states, i)
        if not (onlyHits and sg == 0)
            fired = sg != 0
            bg = sg == 1 ? color.new(color.green, 0) : sg == -1 ? color.new(color.red, 0) : st == 1 ? color.new(color.green, 80) : st == -1 ? color.new(color.red, 80) : color.new(color.gray, 85)
            txt = fired ? color.white : color.gray
            table.cell(panel, 0, row, fired ? "*" : "", text_color = txt, bgcolor = bg, text_size = size.tiny)
            table.cell(panel, 1, row, array.get(names, i), text_color = txt, bgcolor = bg, text_size = size.tiny)
            table.cell(panel, 2, row, st == 1 ? "UP" : st == -1 ? "DOWN" : "-", text_color = txt, bgcolor = bg, text_size = size.tiny)
            table.cell(panel, 3, row, str.tostring(array.get(prices, i), "#.##"), text_color = txt, bgcolor = bg, text_size = size.tiny)
            table.cell(panel, 4, row, str.tostring(array.get(adxs, i), "#.0"), text_color = txt, bgcolor = bg, text_size = size.tiny)
            row += 1
        if row > 40
            break

// ---------------------------- This chart's own symbol -----------------------
// Same rule drawn on whatever symbol the chart is showing, so the triangles and
// the EMA ribbon match what the scanner is alerting on.
emaR = ta.ema(close, fastLen)
emaG = ta.ema(close, midLen)
emaB = ta.ema(close, slowLen)
plot(markChart ? emaR : na, "Red EMA",   color = color.red,   linewidth = 2)
plot(markChart ? emaG : na, "Green EMA", color = color.green, linewidth = 2)
plot(markChart ? emaB : na, "Blue EMA",  color = color.blue,  linewidth = 2)

[cSig, cState, _cPx, _cAdx, _cSl] = srk()
plotshape(markChart and cSig == 1,  "Bullish", shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.small, text = "Bullish", textcolor = color.blue)
plotshape(markChart and cSig == -1, "Bearish", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.small, text = "Bearish", textcolor = color.blue)
bgcolor(markChart ? (cState == 1 ? color.new(color.green, 92) : cState == -1 ? color.new(color.red, 92) : na) : na)
