"//@version=6\r\nindicator(\"trade_with_kareena Tracker\", shorttitle=\"TWK Tracker\", overlay=true, max_labels_count=500, max_boxes_count=100, max_lines_count=100)\r\n\r\ngrpT = \"Table\"\r\nshowTbl   = input.bool(true, \"Show combined table\", group=grpT)\r\ntblPos    = input.string(\"top_right\", \"Table position\", options=[\"top_right\",\"top_left\",\"bottom_right\",\"bottom_left\",\"middle_right\"], group=grpT)\r\nvolLen    = input.int(20, \"Volume MA Length (bars)\", minval=1, group=grpT)\r\nrowAlpha  = input.int(15, \"Row color opacity\", minval=0, maxval=80, group=grpT)\r\ntblSize   = input.string(\"small\", \"Table font size\", options=[\"small\",\"normal\",\"large\",\"huge\"], group=grpT)\r\n\r\ngrpR = \"R-Factor\"\r\nrLen     = input.int(14, \"R-Factor lookback\", minval=2, group=grpR)\r\nbenchSym = input.symbol(\"NSE:NIFTY\", \"Benchmark for Sector Strength\", group=grpR, tooltip=\"Index/sector for relative strength. For crypto try CRYPTOCAP:TOTAL or BINANCE:BTCUSDT. Invalid symbols score 0.\")\r\n\r\ngrpL = \"Smart Trail (purple line)\"\r\nshowLine = input.bool(true, \"Show Smart Trail\", group=grpL)\r\nstMult   = input.float(1.5, \"Multiplier\", minval=0.5, group=grpL)\r\nstATR    = input.int(10, \"ATR length\", minval=1, group=grpL)\r\ncolLine  = input.color(#7e57c2, \"Line color\", group=grpL)\r\n\r\ngrpS = \"LONG / SHORT Signals\"\r\nshowSig    = input.bool(true, \"Show LONG/SHORT signals\", group=grpS)\r\nsigConfirm = input.bool(false, \"Require R-Factor confirmation\", group=grpS)\r\n\r\ngrpB = \"Institutional Footprint Bubbles\"\r\nshowBub   = input.bool(true, \"Show footprint bubbles\", group=grpB)\r\nbubLen    = input.int(20, \"Volume average length\", minval=1, group=grpB)\r\nbubMult   = input.float(1.8, \"Volume threshold (x avg)\", minval=1.0, group=grpB)\r\n\r\ngrpD = \"Reversal Pivot Dots\"\r\nshowDots = input.bool(true, \"Show purple pivot dots\", group=grpD)\r\npivLen   = input.int(5, \"Pivot strength (bars each side)\", minval=1, group=grpD)\r\ncolDot   = input.color(#9c27b0, \"Dot color\", group=grpD)\r\n\r\ngrpP = \"1:2 Auto Position (R:R)\"\r\nshowPos  = input.bool(true, \"Plot current LONG/SHORT position\", group=grpP)\r\nrr       = input.float(2.0, \"Reward : Risk\", minval=0.5, group=grpP, tooltip=\"Target distance = this x stop distance. 2 = 1:2.\")\r\nprojBars = input.int(24, \"Projection width (bars)\", minval=3, group=grpP)\r\n\r\ngrpC = \"Colors\"\r\ncolBuy  = input.color(color.new(#26a69a, 0), \"Buy / Positive\", group=grpC)\r\ncolSell = input.color(color.new(#ef5350, 0), \"Sell / Negative\", group=grpC)\r\n\r\nf_tf(tf) =>\r\n    [bV, sV] = request.security(syminfo.tickerid, tf, [math.sum(close > open ? volume : 0.0, volLen), math.sum(close < open ? volume : 0.0, volLen)], barmerge.gaps_off, barmerge.lookahead_off)\r\n    score = (bV - sV) / math.max(bV + sV, 1)\r\n    [bV, sV, score]\r\n\r\n[bv1,  sv1,  sc1]  = f_tf(\"1\")\r\n[bv3,  sv3,  sc3]  = f_tf(\"3\")\r\n[bv5,  sv5,  sc5]  = f_tf(\"5\")\r\n[bv15, sv15, sc15] = f_tf(\"15\")\r\n[bv30, sv30, sc30] = f_tf(\"30\")\r\n[bv60, sv60, sc60] = f_tf(\"60\")\r\n[bv120,sv120,sc120]= f_tf(\"120\")\r\n[bv240,sv240,sc240]= f_tf(\"240\")\r\n[bvD,  svD,  scD]  = f_tf(\"1D\")\r\n\r\nf_fmt(x) =>\r\n    a = math.abs(x)\r\n    a >= 1e9 ? str.tostring(x/1e9, \"#.##\")+\"B\" : a >= 1e6 ? str.tostring(x/1e6, \"#.##\")+\"M\" : a >= 1e3 ? str.tostring(x/1e3, \"#.##\")+\"K\" : str.tostring(x, \"#.##\")\r\nf_resTxt(s) => s > 0 ? \"Positive (BUY)\" : s < 0 ? \"Negative (SELL)\" : \"Neutral\"\r\nf_rowCol(s) => s > 0 ? color.new(colBuy, rowAlpha) : s < 0 ? color.new(colSell, rowAlpha) : color.new(color.gray, 40)\r\nf_pos(p) => p==\"top_left\"?position.top_left : p==\"top_right\"?position.top_right : p==\"bottom_left\"?position.bottom_left : p==\"bottom_right\"?position.bottom_right : position.middle_right\r\nf_sc(v) => (v >= 0 ? \"+\" : \"\") + str.tostring(v, \"#0.0\")\r\nf_tsize(s) => s==\"small\"?size.small : s==\"normal\"?size.normal : s==\"huge\"?size.huge : size.large\r\nts = f_tsize(tblSize)\r\n\r\nf_row(tbl, row, label, bv, sv, sc) =>\r\n    rc = f_rowCol(sc)\r\n    table.cell(tbl, 0, row, label,        text_color=color.white, bgcolor=rc, text_size=ts)\r\n    table.cell(tbl, 1, row, f_fmt(bv),    text_color=color.white, bgcolor=rc, text_size=ts)\r\n    table.cell(tbl, 2, row, f_fmt(sv),    text_color=color.white, bgcolor=rc, text_size=ts)\r\n    table.cell(tbl, 3, row, f_resTxt(sc), text_color=color.white, bgcolor=rc, text_size=ts)\r\n\r\nf_comp(tbl, row, name, score) =>\r\n    cc = f_rowCol(score)\r\n    table.cell(tbl, 0, row, name,        text_color=color.white, bgcolor=cc, text_size=ts)\r\n    table.cell(tbl, 1, row, f_sc(score), text_color=color.white, bgcolor=cc, text_size=ts)\r\n    table.cell(tbl, 2, row, \"\",          text_color=color.white, bgcolor=cc, text_size=ts)\r\n    table.cell(tbl, 3, row, \"\",          text_color=color.white, bgcolor=cc, text_size=ts)\r\n\r\npriceMom   = (ta.rsi(close, rLen) - 50) / 50 * 20\r\nvolRatio   = volume / math.max(ta.sma(volume, rLen), 1)\r\nvolScore   = math.max(math.min(volRatio - 1, 1), -1) * 20\r\nbench      = request.security(benchSym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)\r\nrs         = na(bench) or na(bench[rLen]) ? na : (close / close[rLen]) / (bench / bench[rLen])\r\nsectorScore= na(rs) ? 0.0 : math.max(math.min((rs - 1) * 50, 1), -1) * 20\r\noiScore    = math.max(math.min(ta.roc(ta.sma(volume, rLen), rLen) / 100, 1), -1) * 20\r\nsmartScore = (ta.mfi(hlc3, rLen) - 50) / 50 * 20\r\n\r\nrFactor = priceMom + volScore + sectorScore + oiScore + smartScore\r\nrCol    = f_rowCol(rFactor)\r\nrBias   = rFactor > 33 ? \"STRONG BUY\" : rFactor > 0 ? \"BUY\" : rFactor < -33 ? \"STRONG SELL\" : rFactor < 0 ? \"SELL\" : \"NEUTRAL\"\r\n\r\nhCol = color.new(#2a2e39, 0)\r\nvar table mt = na\r\nif showTbl\r\n    if na(mt)\r\n        mt := table.new(f_pos(tblPos), 4, 16, border_width=1)\r\n    table.cell(mt, 0,0,\"Periods\",        text_color=color.white, bgcolor=hCol, text_size=ts)\r\n    table.cell(mt, 1,0,\"Buying Volume\",  text_color=color.white, bgcolor=hCol, text_size=ts)\r\n    table.cell(mt, 2,0,\"Selling Volume\", text_color=color.white, bgcolor=hCol, text_size=ts)\r\n    table.cell(mt, 3,0,\"Result\",         text_color=color.white, bgcolor=hCol, text_size=ts)\r\n    f_row(mt,1,\"1m\",  bv1,  sv1,  sc1)\r\n    f_row(mt,2,\"3m\",  bv3,  sv3,  sc3)\r\n    f_row(mt,3,\"5m\",  bv5,  sv5,  sc5)\r\n    f_row(mt,4,\"15m\", bv15, sv15, sc15)\r\n    f_row(mt,5,\"30m\", bv30, sv30, sc30)\r\n    f_row(mt,6,\"1h\",  bv60, sv60, sc60)\r\n    f_row(mt,7,\"2h\",  bv120,sv120,sc120)\r\n    f_row(mt,8,\"4h\",  bv240,sv240,sc240)\r\n    f_row(mt,9,\"1D\",  bvD,  svD,  scD)\r\n    table.cell(mt, 0,10,\"R-FACTOR\",         text_color=color.white, bgcolor=rCol, text_size=ts)\r\n    table.cell(mt, 1,10,str.tostring(rFactor,\"#0.0\"), text_color=color.white, bgcolor=rCol, text_size=ts)\r\n    table.cell(mt, 2,10,\"BIAS\",             text_color=color.white, bgcolor=rCol, text_size=ts)\r\n    table.cell(mt, 3,10,rBias,              text_color=color.white, bgcolor=rCol, text_size=ts)\r\n    f_comp(mt,11,\"Price Momentum\",   priceMom)\r\n    f_comp(mt,12,\"Volume\",           volScore)\r\n    f_comp(mt,13,\"Sector Strength\",  sectorScore)\r\n    f_comp(mt,14,\"OI / Derivatives\", oiScore)\r\n    f_comp(mt,15,\"Smart Money Flow\", smartScore)\r\n\r\n[stVal, stDir] = ta.supertrend(stMult, stATR)\r\nplot(showLine ? stVal : na, \"Smart Trail\", color=colLine, linewidth=2, style=plot.style_linebr)\r\n\r\nbullFlip = stDir < 0 and stDir[1] >= 0\r\nbearFlip = stDir > 0 and stDir[1] <= 0\r\nlongSig  = bullFlip and (not sigConfirm or rFactor > 0)\r\nshortSig = bearFlip and (not sigConfirm or rFactor < 0)\r\n\r\nif showSig and longSig\r\n    label.new(bar_index, low, \"LONG\", yloc=yloc.belowbar, style=label.style_label_up, color=colBuy, textcolor=color.white, size=size.small)\r\nif showSig and shortSig\r\n    label.new(bar_index, high, \"SHORT\", yloc=yloc.abovebar, style=label.style_label_down, color=colSell, textcolor=color.white, size=size.small)\r\n\r\nvAvg  = ta.sma(volume, bubLen)\r\nisBig = volume >= bubMult * vAvg\r\nratio = volume / math.max(vAvg, 1)\r\nbSize = ratio > 4 ? size.huge : ratio > 3 ? size.large : ratio > 2 ? size.normal : size.small\r\nbubCol = close >= open ? color.new(colBuy, 10) : color.new(colSell, 10)\r\nif showBub and isBig\r\n    label.new(bar_index, hlc3, f_fmt(volume), style=label.style_circle, color=bubCol, textcolor=color.white, size=bSize)\r\n\r\nph = ta.pivothigh(high, pivLen, pivLen)\r\npl = ta.pivotlow(low, pivLen, pivLen)\r\nplotshape(showDots and not na(ph), title=\"Pivot High Dot\", style=shape.circle, location=location.abovebar, color=colDot, offset=-pivLen, size=size.tiny)\r\nplotshape(showDots and not na(pl), title=\"Pivot Low Dot\",  style=shape.circle, location=location.belowbar, color=colDot, offset=-pivLen, size=size.tiny)\r\n\r\nvar float lastPL = na\r\nvar float lastPH = na\r\nif not na(pl)\r\n    lastPL := pl\r\nif not na(ph)\r\n    lastPH := ph\r\n\r\n// Keep only ONE position — the current/latest one (delete the previous on each new signal).\r\nvar box   pbRwd = na\r\nvar box   pbRsk = na\r\nvar line  plEnt = na\r\nvar label plLE  = na\r\nvar label plLT  = na\r\nvar label plLS  = na\r\n\r\nif showPos and (longSig or shortSig)\r\n    isL = longSig\r\n    entry = close\r\n    sl = isL ? ((not na(lastPL) and lastPL < close) ? lastPL : stVal) : ((not na(lastPH) and lastPH > close) ? lastPH : stVal)\r\n    risk = isL ? (entry - sl) : (sl - entry)\r\n    if risk > 0\r\n        tp = isL ? (entry + rr * risk) : (entry - rr * risk)\r\n        l = bar_index\r\n        rgt = l + projBars\r\n        if not na(pbRwd)\r\n            box.delete(pbRwd)\r\n        if not na(pbRsk)\r\n            box.delete(pbRsk)\r\n        if not na(plEnt)\r\n            line.delete(plEnt)\r\n        if not na(plLE)\r\n            label.delete(plLE)\r\n        if not na(plLT)\r\n            label.delete(plLT)\r\n        if not na(plLS)\r\n            label.delete(plLS)\r\n        pbRwd := box.new(l, math.max(entry, tp), rgt, math.min(entry, tp), border_color=color.new(colBuy, 0),  bgcolor=color.new(colBuy, 60))\r\n        pbRsk := box.new(l, math.max(entry, sl), rgt, math.min(entry, sl), border_color=color.new(colSell, 0), bgcolor=color.new(colSell, 60))\r\n        plEnt := line.new(l, entry, rgt, entry, color=color.new(color.white, 0), width=2, style=line.style_dashed)\r\n        plLE := label.new(l, entry, (isL ? \"LONG @ \" : \"SHORT @ \") + str.tostring(entry, format.mintick) + \"  (1:\" + str.tostring(rr, \"#.#\") + \")\", style=label.style_label_right, color=color.new(color.gray, 10), textcolor=color.white, size=size.small)\r\n        plLT := label.new(l, tp, \"TP \" + str.tostring(tp, format.mintick), style=label.style_label_right, color=color.new(colBuy, 0),  textcolor=color.white, size=size.small)\r\n        plLS := label.new(l, sl, \"SL \" + str.tostring(sl, format.mintick), style=label.style_label_right, color=color.new(colSell, 0), textcolor=color.white, size=size.small)\r\n\r\nalertcondition(longSig,  \"TWK LONG signal\",  \"trade_with_kareena: LONG (Smart Trail flip up)\")\r\nalertcondition(shortSig, \"TWK SHORT signal\", \"trade_with_kareena: SHORT (Smart Trail flip down)\")\r\n"