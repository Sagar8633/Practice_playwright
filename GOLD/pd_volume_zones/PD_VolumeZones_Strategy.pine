//@version=6
// =====================================================================
//  Previous-Day Volume Zones - Strategy   (PD VolZones Strat)
//
//  Zones: identical engine to PD_VolumeZones_Indicator.pine. Every
//  completed trading day yields Day High / Day Low and the protruding
//  high-volume rectangles of its fixed-range volume profile, each with a
//  POC line. Those rectangles are traded during the FOLLOWING day.
//
//  Trade rules (exactly as specified, nothing added):
//    LONG   POC tap -> green candle CLOSES above the rectangle's top
//           -> buy at that close -> SL below the rectangle's bottom
//           -> TP = entry + 3 x (entry - SL)
//    SHORT  POC tap -> red candle CLOSES below the rectangle's bottom
//           -> sell at that close -> SL above the rectangle's top
//           -> TP = entry - 3 x (SL - entry)
//
//    * A touch of the rectangle is NOT enough: the bar's range must
//      cross the POC line (low <= POC <= high). The tap may be the
//      confirmation bar itself or any of the previous "Tap validity" bars.
//    * SL and TP never move. One position at a time.
//    * One trade per rectangle per day ("Max trades per rectangle").
//    * A setup whose SL is not on the correct side of the entry is ignored.
//
//  Orders are processed on bar close, so the entry price IS the close of
//  the confirmation candle and the target is exactly 3R from it. If you
//  add slippage in the Properties tab, the target is re-anchored to the
//  real fill on the next bar so that it stays exactly 3R (the stop is
//  never touched).
// =====================================================================
strategy("Previous-Day Volume Zones Strategy", "PD VolZones Strat", overlay = true,
     initial_capital         = 10000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     max_boxes_count         = 500,
     max_lines_count         = 500,
     max_labels_count        = 500)

// ------------------------------------------------------------------ //
//  INPUTS - zones (same as the indicator)
// ------------------------------------------------------------------ //
gD = "Trading day"
sessStr = input.session("0000-0000", "Day session (profile window)", group = gD,
     tooltip = "Bars inside this window make up one day. 0000-0000 = the whole calendar day in the timezone below.")
tzStr   = input.string("Asia/Kolkata", "Timezone", group = gD,
     tooltip = "IANA name such as Asia/Kolkata, UTC or America/New_York. Empty = the exchange timezone of the symbol.")
minHours = input.float(8, "Minimum day length (hours)", minval = 0.5, step = 0.5, group = gD,
     tooltip = "A day with less than this many hours of bars (the Saturday stub after the Friday close, a holiday) is skipped and the previous zones stay active.")

gP = "Volume profile"
nBins      = input.int(40, "Volume bins", minval = 10, maxval = 200, group = gP)
useLTF     = input.bool(false, "Build the profile from a lower timeframe", group = gP,
     tooltip = "Uses intrabar data instead of the chart's bars. TradingView caps intrabar history, so older days silently fall back to chart bars.")
ltfStr     = input.timeframe("1", "Lower timeframe", group = gP)
smoothBins = input.int(1, "Smoothing (bins)", minval = 1, maxval = 9, step = 2, group = gP)

gZ = "Zone detection"
minProm   = input.float(0.20, "Minimum prominence (0-1)", minval = 0, maxval = 1, step = 0.05, group = gZ,
     tooltip = "A peak must stand above the valleys on BOTH sides by this fraction of its own volume.")
minShare  = input.float(0.25, "Minimum volume vs. day POC (0-1)", minval = 0, maxval = 1, step = 0.05, group = gZ)
peakWin   = input.int(2, "Peak window (bins each side)", minval = 1, maxval = 10, group = gZ)
extendThr = input.float(0.75, "Zone extension threshold (0-1)", minval = 0, maxval = 1, step = 0.05, group = gZ)
maxHalf   = input.int(1, "Maximum rectangle half-height (bins)", minval = 0, maxval = 20, group = gZ)
minSep    = input.int(3, "Minimum zone separation (bins)", minval = 0, maxval = 50, group = gZ)
maxZones  = input.int(4, "Maximum internal zones", minval = 0, maxval = 20, group = gZ)
pocMode   = input.string("Highest-volume bin", "POC line", options = ["Highest-volume bin", "Rectangle midpoint"], group = gZ)

gB = "Day High / Day Low"
showHL    = input.bool(true, "Draw Day High / Day Low lines", group = gB)
edgeZones = input.bool(true, "Rectangle at Day High and Day Low", group = gB)
edgeBins  = input.int(2, "Boundary rectangle height (bins)", minval = 1, maxval = 10, group = gB)

// ------------------------------------------------------------------ //
//  INPUTS - trading
// ------------------------------------------------------------------ //
gT = "Trade rules"
allowLong  = input.bool(true, "Long setups", group = gT)
allowShort = input.bool(true, "Short setups", group = gT)
tradeEdge  = input.bool(true, "Trade the Day High / Day Low rectangles too", group = gT)
tapValid   = input.int(12, "Tap validity (bars)", minval = 1, group = gT,
     tooltip = "The confirmation close must come within this many bars of the last POC tap. 1 = the tap must be on the confirmation candle itself.")
rrMult     = input.float(3.0, "Reward : risk", minval = 0.5, step = 0.5, group = gT,
     tooltip = "Specification = 3.")
slBuf      = input.float(0.0, "SL buffer beyond the rectangle (price)", minval = 0, group = gT,
     tooltip = "0 = SL exactly at the rectangle's far edge.")
maxPerZone = input.int(1, "Max trades per rectangle (per day)", minval = 1, group = gT)
minRisk    = input.float(0.0, "Minimum risk (price), 0 = off", minval = 0, group = gT)
maxRisk    = input.float(0.0, "Maximum risk (price), 0 = off", minval = 0, group = gT,
     tooltip = "Skip a setup whose entry-to-SL distance is larger than this (e.g. a huge confirmation candle).")
tradeSess  = input.session("0000-0000", "Trading session", group = gT,
     tooltip = "New entries only inside this window (timezone above). Open trades are NOT closed at its end unless the option below is on.")
closeEOD   = input.bool(false, "Close the open trade when the trading session ends", group = gT)

gR = "Position size"
sizeMode = input.string("Risk % of equity", "Sizing", options = ["Risk % of equity", "Fixed quantity"], group = gR)
riskPct  = input.float(1.0, "Risk per trade (% of equity)", minval = 0.01, step = 0.25, group = gR)
fixedQty = input.float(1.0, "Fixed quantity", minval = 0.0001, group = gR)

gW = "Backtest window"
lookbackDays = input.int(0, "Backtest window (days), 0 = all history", minval = 0, group = gW,
     tooltip = "Entries only within the last N days. Lets you restrict the test without Deep Backtesting.")

gV = "Visuals"
showHist  = input.bool(false, "Profile histogram (latest day only)", group = gV)
histWidth = input.int(60, "Histogram max width (bars)", minval = 5, maxval = 500, group = gV)
showText  = input.bool(true, "Labels", group = gV)
markTaps  = input.bool(true, "Mark POC taps", group = gV)
sendAlerts = input.bool(true, "alert() on every entry", group = gV,
     tooltip = "Create an alert on this strategy with 'Order fills and alert() function calls' to receive them.")
colHL     = input.color(#787b86, "Day High / Low", group = gV)
colBorder = input.color(#787b86, "Rectangle border", group = gV)
colFill   = input.color(color.new(#9c27b0, 90), "Rectangle fill", group = gV)
colPOC    = input.color(#e91e63, "POC line", group = gV)
colHist   = input.color(color.new(#26c6da, 60), "Histogram", group = gV)
colHistHi = input.color(color.new(#e91e63, 40), "Histogram inside a zone", group = gV)

// ------------------------------------------------------------------ //
//  DAY / SESSION DETECTION
// ------------------------------------------------------------------ //
tzUse    = tzStr == "" ? syminfo.timezone : tzStr
inSess   = not na(time(timeframe.period, sessStr, tzUse))
dayKey   = year(time, tzUse) * 10000 + month(time, tzUse) * 100 + dayofmonth(time, tzUse)
newDay   = dayKey != nz(dayKey[1], dayKey)
sessOpen = inSess and (not inSess[1] or newDay)
sessDone = inSess[1] and (not inSess or newDay)
inTrade  = not na(time(timeframe.period, tradeSess, tzUse))
inWindow = lookbackDays == 0 or time >= timenow - lookbackDays * 86400000.0

ltfOk = useLTF and timeframe.in_seconds(ltfStr) < timeframe.in_seconds()
[ltfH, ltfL, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfOk ? ltfStr : timeframe.period,
     [high, low, volume], ignore_invalid_timeframe = true)

// ------------------------------------------------------------------ //
//  STATE
// ------------------------------------------------------------------ //
var hiArr = array.new<float>()
var loArr = array.new<float>()
var vlArr = array.new<float>()
var int sessStartBar = na
var int sessBars     = 0

var zTop    = array.new<float>()
var zBot    = array.new<float>()
var zPoc    = array.new<float>()
var zType   = array.new<int>()          // 0 = internal HVN, 1 = Day High, 2 = Day Low
var zBox    = array.new<box>()
var zLine   = array.new<line>()
var zTapBar = array.new<int>()          // bar_index of the last POC tap, -1 = none
var zTrades = array.new<int>()          // entries already taken from this rectangle
var hlLines   = array.new<line>()
var hlLabels  = array.new<label>()
var histBoxes = array.new<box>()
var float pdh = na
var float pdl = na

// open-trade bookkeeping (SL/TP are fixed at entry and never changed)
var int   trSide  = 0                   // +1 long, -1 short, 0 none
var float trSL    = na
var float trTP    = na
var float trEntry = na
var int   trZone  = -1
var line  slLn    = na
var line  tpLn    = na
var line  enLn    = na

// ------------------------------------------------------------------ //
//  PROFILE MATHS (pure functions)
// ------------------------------------------------------------------ //
f_profile(array<float> hi, array<float> lo, array<float> vol, float pLow, float binSize, int n) =>
    prof = array.new<float>(n, 0.0)
    cnt = array.size(vol)
    if cnt > 0
        for i = 0 to cnt - 1
            bh = array.get(hi, i)
            bl = array.get(lo, i)
            bq = array.get(vol, i)
            if bq > 0 and not na(bh) and not na(bl)
                b0 = math.max(0, math.min(n - 1, math.floor((bl - pLow) / binSize)))
                b1 = math.max(0, math.min(n - 1, math.floor((bh - pLow) / binSize)))
                if b1 <= b0
                    array.set(prof, b0, array.get(prof, b0) + bq)
                else
                    span = bh - bl
                    for j = b0 to b1
                        binLo = pLow + j * binSize
                        binHi = binLo + binSize
                        ov = math.min(bh, binHi) - math.max(bl, binLo)
                        if ov > 0
                            array.set(prof, j, array.get(prof, j) + bq * ov / span)
    prof

f_smooth(array<float> v, int w) =>
    n = array.size(v)
    out = array.copy(v)
    half = math.floor(w / 2)
    if half > 0 and n > 0
        for i = 0 to n - 1
            s = 0.0
            c = 0
            for j = math.max(0, i - half) to math.min(n - 1, i + half)
                s += array.get(v, j)
                c += 1
            array.set(out, i, s / c)
    out

f_isPeak(array<float> v, int i, int w) =>
    n = array.size(v)
    pv = array.get(v, i)
    ok = pv > 0
    if ok
        for j = math.max(0, i - w) to math.min(n - 1, i + w)
            if j != i
                q = array.get(v, j)
                if q > pv or (q == pv and j < i)
                    ok := false
    ok

f_prominence(array<float> v, int i) =>
    n = array.size(v)
    pv = array.get(v, i)
    minL = pv
    j = i - 1
    while j >= 0 and array.get(v, j) <= pv
        minL := math.min(minL, array.get(v, j))
        j -= 1
    minR = pv
    j := i + 1
    while j < n and array.get(v, j) <= pv
        minR := math.min(minR, array.get(v, j))
        j += 1
    pv - math.max(minL, minR)

f_extend(array<float> v, int i, float thr, int maxH) =>
    n = array.size(v)
    lim = thr * array.get(v, i)
    lo = i
    hi = i
    while lo > 0 and i - lo < maxH and array.get(v, lo - 1) >= lim
        lo -= 1
    while hi < n - 1 and hi - i < maxH and array.get(v, hi + 1) >= lim
        hi += 1
    [lo, hi]

f_argmax(array<float> v, int a, int b) =>
    best = a
    bv = array.get(v, a)
    if b > a
        for j = a + 1 to b
            if array.get(v, j) > bv
                bv := array.get(v, j)
                best := j
    best

f_sumRange(array<float> v, int a, int b) =>
    s = 0.0
    if b >= a
        for j = a to b
            s += array.get(v, j)
    s

// ------------------------------------------------------------------ //
//  DRAWING HELPERS
// ------------------------------------------------------------------ //
f_addZone(float top, float bot, float poc, int kind, float share) =>
    txt = not showText ? "" : kind == 1 ? "PDH" : kind == 2 ? "PDL" : "HVN " + str.tostring(share * 100, "#") + "%"
    bx = box.new(sessStartBar, top, bar_index, bot, border_color = colBorder, border_width = 1,
         bgcolor = colFill, extend = extend.right, text = txt, text_size = size.small,
         text_color = colBorder, text_halign = text.align_left, text_valign = text.align_center)
    pl = line.new(sessStartBar, poc, bar_index, poc, extend = extend.right, color = colPOC,
         style = line.style_dashed, width = 1)
    array.push(zTop, top)
    array.push(zBot, bot)
    array.push(zPoc, poc)
    array.push(zType, kind)
    array.push(zBox, bx)
    array.push(zLine, pl)
    array.push(zTapBar, -1)
    array.push(zTrades, 0)

f_addHL(float price, string txt) =>
    array.push(hlLines, line.new(sessStartBar, price, bar_index, price, extend = extend.right, color = colHL, width = 1))
    if showText
        array.push(hlLabels, label.new(bar_index, price, txt + " " + str.tostring(price, format.mintick),
             style = label.style_label_left, color = color.new(colHL, 100), textcolor = colHL, size = size.small))

f_freeze() =>
    nOld = array.size(zBox)
    if nOld > 0
        for k = 0 to nOld - 1
            bx = array.get(zBox, k)
            box.set_extend(bx, extend.none)
            box.set_right(bx, bar_index - 1)
            pl = array.get(zLine, k)
            line.set_extend(pl, extend.none)
            line.set_x2(pl, bar_index - 1)
    nHL = array.size(hlLines)
    if nHL > 0
        for k = 0 to nHL - 1
            hl = array.get(hlLines, k)
            line.set_extend(hl, extend.none)
            line.set_x2(hl, bar_index - 1)
    nLb = array.size(hlLabels)
    if nLb > 0
        for k = 0 to nLb - 1
            label.delete(array.get(hlLabels, k))
    array.clear(zTop)
    array.clear(zBot)
    array.clear(zPoc)
    array.clear(zType)
    array.clear(zBox)
    array.clear(zLine)
    array.clear(zTapBar)
    array.clear(zTrades)
    array.clear(hlLines)
    array.clear(hlLabels)

f_inZone(float price) =>
    hit = false
    nZ = array.size(zTop)
    if nZ > 0
        for k = 0 to nZ - 1
            if price <= array.get(zTop, k) and price >= array.get(zBot, k)
                hit := true
    hit

// ------------------------------------------------------------------ //
//  1. A DAY JUST ENDED -> BUILD ITS PROFILE AND THE ZONES
// ------------------------------------------------------------------ //
if sessDone and barstate.isconfirmed
    if sessBars * timeframe.in_seconds() / 3600 >= minHours and array.size(vlArr) > 0
        pHigh = array.max(hiArr)
        pLow  = array.min(loArr)
        rng   = pHigh - pLow
        if rng > 0
            binSize = rng / nBins
            raw   = f_profile(hiArr, loArr, vlArr, pLow, binSize, nBins)
            sv    = f_smooth(raw, smoothBins)
            maxV  = array.max(sv)
            totV  = array.sum(raw)
            edge  = edgeZones ? edgeBins : 0
            cIdx = array.new<int>()
            cLo  = array.new<int>()
            cHi  = array.new<int>()
            cVol = array.new<float>()
            if maxV > 0 and nBins - 1 - edge >= edge
                for i = edge to nBins - 1 - edge
                    if f_isPeak(sv, i, peakWin)
                        pv   = array.get(sv, i)
                        prom = f_prominence(sv, i)
                        if pv / maxV >= minShare and prom / pv >= minProm
                            [el, eh] = f_extend(sv, i, extendThr, maxHalf)
                            array.push(cIdx, i)
                            array.push(cLo, math.max(el, edge))
                            array.push(cHi, math.min(eh, nBins - 1 - edge))
                            array.push(cVol, pv)
            sIdx = array.new<int>()
            sLo  = array.new<int>()
            sHi  = array.new<int>()
            nC = array.size(cIdx)
            if nC > 0
                used = array.new<bool>(nC, false)
                for p = 1 to nC
                    best  = -1
                    bestV = -1.0
                    for c = 0 to nC - 1
                        if not array.get(used, c) and array.get(cVol, c) > bestV
                            bestV := array.get(cVol, c)
                            best  := c
                    array.set(used, best, true)
                    okSep = true
                    nS = array.size(sIdx)
                    if nS > 0
                        for s = 0 to nS - 1
                            gap = math.max(array.get(sLo, s) - array.get(cHi, best), array.get(cLo, best) - array.get(sHi, s)) - 1
                            if gap < minSep
                                okSep := false
                    if okSep and array.size(sIdx) < maxZones
                        array.push(sIdx, array.get(cIdx, best))
                        array.push(sLo, array.get(cLo, best))
                        array.push(sHi, array.get(cHi, best))
            f_freeze()
            pdh := pHigh
            pdl := pLow
            if showHL
                f_addHL(pHigh, "PDH")
                f_addHL(pLow, "PDL")
            if edgeZones and edgeBins < nBins
                hiLo = nBins - edgeBins
                pkH  = f_argmax(sv, hiLo, nBins - 1)
                topH = pHigh
                botH = pLow + hiLo * binSize
                pocH = pocMode == "Rectangle midpoint" ? (topH + botH) / 2 : pLow + (pkH + 0.5) * binSize
                f_addZone(topH, botH, pocH, 1, totV > 0 ? f_sumRange(raw, hiLo, nBins - 1) / totV : 0)
                pkL  = f_argmax(sv, 0, edgeBins - 1)
                topL = pLow + edgeBins * binSize
                botL = pLow
                pocL = pocMode == "Rectangle midpoint" ? (topL + botL) / 2 : pLow + (pkL + 0.5) * binSize
                f_addZone(topL, botL, pocL, 2, totV > 0 ? f_sumRange(raw, 0, edgeBins - 1) / totV : 0)
            nSel = array.size(sIdx)
            if nSel > 0
                for s = 0 to nSel - 1
                    pk  = array.get(sIdx, s)
                    lb  = array.get(sLo, s)
                    hb  = array.get(sHi, s)
                    zb  = pLow + lb * binSize
                    zt  = pLow + (hb + 1) * binSize
                    zp  = pocMode == "Rectangle midpoint" ? (zt + zb) / 2 : pLow + (pk + 0.5) * binSize
                    f_addZone(zt, zb, zp, 0, totV > 0 ? f_sumRange(raw, lb, hb) / totV : 0)
            nH = array.size(histBoxes)
            if nH > 0
                for i = 0 to nH - 1
                    box.delete(array.get(histBoxes, i))
            array.clear(histBoxes)
            if showHist
                rawMax = array.max(raw)
                if rawMax > 0
                    for i = 0 to nBins - 1
                        v = array.get(raw, i)
                        if v > 0
                            wBars = math.max(1, math.round(histWidth * v / rawMax))
                            bLo = pLow + i * binSize
                            bHi = bLo + binSize
                            inZ = f_inZone(bLo + binSize / 2)
                            array.push(histBoxes, box.new(sessStartBar, bHi, sessStartBar + wBars, bLo,
                                 border_color = na, bgcolor = inZ ? colHistHi : colHist))
    array.clear(hiArr)
    array.clear(loArr)
    array.clear(vlArr)
    sessBars := 0

// ------------------------------------------------------------------ //
//  2. A DAY STARTS
// ------------------------------------------------------------------ //
if sessOpen and barstate.isconfirmed
    sessStartBar := bar_index

// ------------------------------------------------------------------ //
//  3. ACCUMULATE THE CURRENT BAR
// ------------------------------------------------------------------ //
if inSess and barstate.isconfirmed
    if na(sessStartBar)
        sessStartBar := bar_index
    sessBars += 1
    nL = array.size(ltfV)
    if ltfOk and nL > 0
        for k = 0 to nL - 1
            array.push(hiArr, array.get(ltfH, k))
            array.push(loArr, array.get(ltfL, k))
            array.push(vlArr, nz(array.get(ltfV, k)))
    else
        array.push(hiArr, high)
        array.push(loArr, low)
        array.push(vlArr, nz(volume))

nLbl = array.size(hlLabels)
if nLbl > 0
    for k = 0 to nLbl - 1
        label.set_x(array.get(hlLabels, k), bar_index)

// ------------------------------------------------------------------ //
//  4. SETUP DETECTION:  POC tap -> confirmation close outside the box
// ------------------------------------------------------------------ //
bool  sigLong  = false
bool  sigShort = false
int   sigZone  = -1
float tapPx    = na

nZ = array.size(zTop)
if nZ > 0 and barstate.isconfirmed
    for k = 0 to nZ - 1
        top = array.get(zTop, k)
        bot = array.get(zBot, k)
        poc = array.get(zPoc, k)
        if low <= poc and high >= poc
            array.set(zTapBar, k, bar_index)
            if na(tapPx)
                tapPx := poc
        tb     = array.get(zTapBar, k)
        hasTap = tb >= 0 and bar_index - tb < tapValid
        canUse = (tradeEdge or array.get(zType, k) == 0) and array.get(zTrades, k) < maxPerZone
        if hasTap and canUse
            if allowLong and close > open and close > top
                // several rectangles can qualify on one candle: take the nearest (tightest SL)
                if sigZone < 0 or top > array.get(zTop, sigZone)
                    sigLong := true
                    sigZone := k
            else if allowShort and close < open and close < bot
                if sigZone < 0 or bot < array.get(zBot, sigZone)
                    sigShort := true
                    sigZone := k

// ------------------------------------------------------------------ //
//  5. EXECUTION
// ------------------------------------------------------------------ //
bool takenLong  = false
bool takenShort = false
bool skipLong   = false
bool skipShort  = false
flat = strategy.position_size == 0

if (sigLong or sigShort) and inTrade and inWindow
    k    = sigZone
    top  = array.get(zTop, k)
    bot  = array.get(zBot, k)
    poc  = array.get(zPoc, k)
    sl   = sigLong ? bot - slBuf : top + slBuf
    risk = sigLong ? close - sl : sl - close
    okRisk = risk > 0 and (minRisk == 0 or risk >= minRisk) and (maxRisk == 0 or risk <= maxRisk)
    if okRisk
        tp  = sigLong ? close + rrMult * risk : close - rrMult * risk
        qty = sizeMode == "Risk % of equity" ? strategy.equity * riskPct / 100 / risk : fixedQty
        if flat and qty > 0
            array.set(zTrades, k, array.get(zTrades, k) + 1)
            array.set(zTapBar, k, -1)
            if sigLong
                strategy.entry("Long", strategy.long, qty = qty, comment = "L zone " + str.tostring(k))
                strategy.exit("Long exit", "Long", stop = sl, limit = tp, comment_loss = "SL", comment_profit = "TP")
                takenLong := true
            else
                strategy.entry("Short", strategy.short, qty = qty, comment = "S zone " + str.tostring(k))
                strategy.exit("Short exit", "Short", stop = sl, limit = tp, comment_loss = "SL", comment_profit = "TP")
                takenShort := true
            trSide  := sigLong ? 1 : -1
            trSL    := sl
            trTP    := tp
            trEntry := close
            trZone  := k
            slLn := line.new(bar_index, sl, bar_index + 1, sl, color = color.new(color.red, 20), width = 1)
            tpLn := line.new(bar_index, tp, bar_index + 1, tp, color = color.new(color.green, 20), width = 1)
            enLn := line.new(bar_index, close, bar_index + 1, close, color = color.new(color.gray, 20), style = line.style_dotted)
            if showText
                label.new(bar_index, sigLong ? bot : top,
                     (sigLong ? "LONG" : "SHORT") + "\nE " + str.tostring(close, format.mintick) +
                     "\nSL " + str.tostring(sl, format.mintick) + "\nTP " + str.tostring(tp, format.mintick) +
                     "\nR " + str.tostring(risk, format.mintick),
                     style = sigLong ? label.style_label_up : label.style_label_down,
                     color = color.new(sigLong ? color.green : color.red, 70), textcolor = color.white, size = size.small)
            if sendAlerts
                alert("PDVZ " + (sigLong ? "LONG" : "SHORT") + " " + syminfo.ticker +
                     " entry=" + str.tostring(close, format.mintick) +
                     " sl=" + str.tostring(sl, format.mintick) +
                     " tp=" + str.tostring(tp, format.mintick) +
                     " poc=" + str.tostring(poc, format.mintick), alert.freq_once_per_bar_close)
        else
            skipLong  := sigLong
            skipShort := sigShort

// Re-anchor the target to the real fill so it is exactly R:R x risk (only
// matters when slippage is configured). The stop is never changed.
posSize = strategy.position_size
if posSize != 0 and posSize[1] == 0 and trSide != 0
    entryPx = strategy.position_avg_price
    riskA   = trSide > 0 ? entryPx - trSL : trSL - entryPx
    if riskA > 0
        tpA = trSide > 0 ? entryPx + rrMult * riskA : entryPx - rrMult * riskA
        if trSide > 0
            strategy.exit("Long exit", "Long", stop = trSL, limit = tpA, comment_loss = "SL", comment_profit = "TP")
        else
            strategy.exit("Short exit", "Short", stop = trSL, limit = tpA, comment_loss = "SL", comment_profit = "TP")
        trTP    := tpA
        trEntry := entryPx
        if not na(tpLn)
            line.set_y1(tpLn, tpA)
            line.set_y2(tpLn, tpA)
    else
        // the fill landed on the wrong side of the stop (gap): not a valid setup
        strategy.close_all(comment = "invalid SL")

if posSize != 0 and not na(slLn)
    line.set_x2(slLn, bar_index)
    line.set_x2(tpLn, bar_index)
    line.set_x2(enLn, bar_index)

if posSize == 0 and posSize[1] != 0
    trSide := 0

if closeEOD and inTrade[1] and not inTrade and posSize != 0
    strategy.close_all(comment = "session end")

// ------------------------------------------------------------------ //
//  6. PLOTS
// ------------------------------------------------------------------ //
plotshape(markTaps ? tapPx : na, "POC tap", shape.circle, location.absolute, color.new(color.orange, 30), size = size.tiny)
plotshape(takenLong,  "Long entry",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(takenShort, "Short entry", shape.triangledown, location.abovebar, color.new(color.red, 0),   size = size.small)
plotshape(skipLong,  "Long setup skipped (position open)",  shape.triangleup,   location.belowbar, color.new(color.gray, 30), size = size.tiny)
plotshape(skipShort, "Short setup skipped (position open)", shape.triangledown, location.abovebar, color.new(color.gray, 30), size = size.tiny)
plot(pdh, "Previous day high", display = display.data_window)
plot(pdl, "Previous day low",  display = display.data_window)
