def load_path(kind: str = "m1") -> dict:
    """Path bars restricted to XM trading minutes, with server hour, day index and weekday."""
    if kind in _PATH_CACHE:
        return _PATH_CACHE[kind]
    z = np.load(os.path.join(DATA, f"{kind}_server.npz"))
    t = z["t"].astype(np.int64)
    mod = (t % 86400) // 60
    keep = (mod >= SESSION_OPEN_MIN) & (mod < SESSION_CLOSE_MIN) if kind == "m1" else (mod >= 60)
    d = {"t": t[keep], "o": z["o"][keep].astype(np.float64), "h": z["h"][keep].astype(np.float64), "l": z["l"][keep].astype(np.float64),
         "c": z["c"][keep].astype(np.float64), "v": z["v"][keep].astype(np.float64)}
    d["hour"] = ((d["t"] % 86400) // 3600).astype(np.int64)
    d["day"] = (d["t"] // 86400).astype(np.int64)
    d["wday"] = ((d["day"] + 3) % 7).astype(np.int64)     # Monday = 0
    d["year"] = pd.to_datetime(d["t"], unit="s").year.to_numpy().astype(np.int64)
    d["dropped_out_of_session"] = int((~keep).sum())
    _PATH_CACHE[kind] = d
    return d


def spread_model() -> np.ndarray:
    """spread[year-2000, hour] in points (M1-equivalent XM GOLD)."""
    global _SPREAD
    if _SPREAD is None:
        with open(os.path.join(DATA, "spread_model.json")) as f:
            m = json.load(f)["model_points_by_year_hour"]
        arr = np.zeros((40, 24))
        for y in range(2000, 2040):
            src = m.get(str(y)) or m.get(str(min(max(y, 2003), 2026)))
            arr[y - 2000] = src
        _SPREAD = arr
    return _SPREAD


def build_tf(path: dict, tf_minutes: int) -> dict:
    """Signal-timeframe bars from path bars (server time buckets) + mapping arrays."""
    key = (id(path), tf_minutes)
    if key in _TF_CACHE:
        return _TF_CACHE[key]
    t = path["t"]
    bucket = (t // (tf_minutes * 60)) * (tf_minutes * 60)
    change = np.empty(len(t), bool); change[0] = True; change[1:] = bucket[1:] != bucket[:-1]
    starts = np.where(change)[0]
    ends = np.append(starts[1:], len(t))
    n = len(starts)
    tf = {"t": bucket[starts], "o": path["o"][starts], "c": path["c"][ends - 1],
          "h": np.maximum.reduceat(path["h"], starts), "l": np.minimum.reduceat(path["l"], starts), "v": np.add.reduceat(path["v"], starts),
          "n": n}
    tfj = np.cumsum(change) - 1
    tf["tfj"] = tfj.astype(np.int64)
    tf["newbar"] = change.astype(np.int8)
    tf["hour"] = ((tf["t"] % 86400) // 3600).astype(np.int64)
    _TF_CACHE[key] = tf
    return tf


