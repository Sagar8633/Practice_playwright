# business_radar secrets. Copy this file to config/.env and fill it in.
#
# config/.env is gitignored and is the ONLY place a credential belongs. Nothing in
# config.yaml is secret and nothing here is committed.
#
# Format: KEY=value, one per line. No quotes needed and no `export`. Lines starting with
# # are ignored. radar/config.py parses this file itself; python-dotenv is not required.

# ---------------------------------------------------------------------------
# Google Gemini (required)
# ---------------------------------------------------------------------------
# Free-tier key from Google AI Studio: https://aistudio.google.com/apikey
# Without this, research, message drafting and response classification cannot run, and
# radar/config.py refuses to start with a message naming this file.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Outreach email (optional - the email channel is unconfigured without it)
# ---------------------------------------------------------------------------
# Use a DEDICATED free Gmail account created for this purpose, never your personal address.
# The blast radius of a spam complaint should be an account you can abandon, not the address
# your clients already have.
#
# BEFORE you can generate an App Password:
#   1. 2-Step Verification must be ON for that Google account. App Passwords do not exist as an
#      option until it is. Google Account -> Security -> 2-Step Verification.
#   2. Then generate the password at Google Account -> Security -> App passwords. It is 16
#      characters, shown once. Paste it below with or without spaces; both are accepted.
#   3. IMAP must be ENABLED in Gmail settings (Gmail -> See all settings -> Forwarding and
#      POP/IMAP -> Enable IMAP), or reply capture, bounce detection and - critically - the
#      mailto: unsubscribe path will silently never see anything.
#
# Leaving these blank is a supported state. Discovery, research, verification, drafting and
# approval all work; only the send and poll steps report the channel as unconfigured.
OUTREACH_GMAIL_ADDRESS=
OUTREACH_GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Telegram alerts for human handoffs. Leave blank to disable; handoffs are still created and
# still visible at /handoffs, you just are not paged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Overrides the config.yaml path. Rarely needed.
# RADAR_CONFIG=
# Overrides the data directory (database, captures, reports, outbox, logs).
# RADAR_HOME=
