// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// Sagar_Liquidity  (XAU liquidity map + sweeps)
//
// WHAT IT DOES
//   1. Builds a live map of RESTING LIQUIDITY on the chart:
//        * Buy-side liquidity  (BSL) = confirmed swing highs, equal highs (EQH),
//          previous day / week high, previous Asia / London / NY session high.
//        * Sell-side liquidity (SSL) = the mirror image below price.
//      Each pending pool is a dashed line that keeps extending right until it is taken.
//   2. Watches every pending pool bar by bar and, the moment it is taken, prints the
//      event on the chart:
//        * SWEEP  = price pushes beyond the level (by at least the minimum penetration)
//                   and then CLOSES back inside within the reclaim window. The stop-run
//                   / liquidity-grab. Drawn as a solid line end, a shaded "sweep area"
//                   box from the level to the wick extreme, and a label.
//        * BREAK  = price CLOSES beyond the level and stays there (acceptance). The
//                   pool was consumed by a breakout, not a raid. Muted label.
//   3. A status table shows how much liquidity is still pending above and below,
//      the nearest pool on each side with its distance in USD, and whether the
//      current live bar is TESTING one of them right now.
//
// NON-REPAINTING DESIGN
//   * A swing is only added after `Swing confirmation` bars have closed beyond it
//     (ta.pivothigh / ta.pivotlow), so a level never appears and then disappears.
//   * All level state changes happen on CONFIRMED bars only. The live bar can show
//     "TESTING" in the table, but no sweep is printed until the bar closes.
//   * Every tolerance is denominated in USD per ounce (OANDA:XAUUSD mintick is 0.001,
//     MT5 point is 0.01 - a tick-denominated threshold would mis-scale 10x).
//
// XAUUSD DEFAULTS (5m chart): swing 10/10, EQ tolerance 0.50 USD, min penetration
//   0.20 USD, reclaim buffer 0.05 USD, reclaim window 3 bars. On 1m halve the USD
//   values; on 15m/1h double them, or switch the tolerance mode to ATR.
//
//@version=6
indicator("Sagar_Liquidity", shorttitle = "Sagar_Liquidity", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// =============================================================== INPUTS
G1 = "1 - Swing liquidity"
i_swL      = input.int(10, "Swing lookback (bars left)", minval = 2, maxval = 100, group = G1,
     tooltip = "Bars to the LEFT of a candle that must be lower (for a swing high) or higher (for a swing low).")
i_swR      = input.int(10, "Swing confirmation (bars right)", minval = 1, maxval = 100, group = G1,
     tooltip = "Bars that must close after the swing before it is confirmed. The level is drawn " +
               "this many bars late and never repaints. Lower = earlier but noisier levels.")
i_maxSide  = input.int(8, "Max pending swing pools per side", minval = 1, maxval = 40, group = G1,
     tooltip = "Oldest pending swing pool on a side is dropped when a new one would exceed this. " +
               "Key levels (PD / PW / session) are extra and never evicted by this cap.")
i_maxAge   = input.int(600, "Expire untouched pools after (bars)", minval = 50, maxval = 5000, group = G1)

G2 = "2 - Equal highs / lows"
i_eqOn     = input.bool(true, "Cluster equal highs / lows (EQH / EQL)", group = G2,
     tooltip = "Two or more swings within the tolerance are merged into ONE pool at the EXTREME " +
               "price (never the average - the resting stops sit beyond the extreme). Merged pools " +
               "are labelled EQH / EQL with the touch count and drawn thicker.")
i_tolMode  = input.string("USD", "Tolerance mode", options = ["USD", "ATR"], group = G2)
i_tolUsd   = input.float(0.50, "Tolerance (USD per oz)", minval = 0.01, step = 0.05, group = G2)
i_tolAtr   = input.float(0.15, "Tolerance (x ATR 14)", minval = 0.01, step = 0.05, group = G2)

G3 = "3 - Key levels (calendar based)"
i_tz       = input.string("America/New_York", "Trading-day timezone (IANA)", group = G3,
     tooltip = "Previous day / week high-low are cut on the CALENDAR day in this zone, not on the " +
               "feed's daily bar (a gold CFD daily bar rolls at 17:00 NY and is stale by London).")
i_pdOn     = input.bool(true, "Previous day high / low (PDH / PDL)", group = G3)
i_pwOn     = input.bool(true, "Previous week high / low (PWH / PWL)", group = G3)
i_asiaOn   = input.bool(true, "Asia session high / low", group = G3)
i_asiaSess = input.session("0900-1500", "Asia session (Asia/Tokyo)", group = G3)
i_lonOn    = input.bool(true, "London session high / low", group = G3)
i_lonSess  = input.session("0800-1630", "London session (Europe/London)", group = G3)
i_nyOn     = input.bool(false, "New York session high / low", group = G3)
i_nySess   = input.session("0800-1700", "New York session (America/New_York)", group = G3)

G4 = "4 - Sweep detection"
i_minPen   = input.float(0.20, "Min penetration beyond level (USD)", minval = 0.0, step = 0.05, group = G4,
     tooltip = "Price must push at least this far beyond a pool before it counts as taken. " +
               "Keeps spread noise from printing sweeps. 0 = any touch beyond the level.")
i_buf      = input.float(0.05, "Reclaim buffer (USD)", minval = 0.0, step = 0.01, group = G4,
     tooltip = "A close must sit this far back INSIDE the level to count as a reclaim (sweep), " +
               "or this far BEYOND it to count as acceptance (break).")
i_window   = input.int(3, "Reclaim window (bars)", minval = 1, maxval = 20, group = G4,
     tooltip = "Bars allowed for the reclaiming close, counting the penetration bar. If no " +
               "decisive close arrives, the pool resolves by where the last close sits.")
i_accept   = input.int(2, "Closes beyond = break", minval = 1, maxval = 10, group = G4,
     tooltip = "This many closes beyond the level inside the window reclassify the event as a " +
               "BREAK (acceptance) instead of a sweep.")
i_showBrk  = input.bool(true, "Show breaks (close-through) too", group = G4)

G5 = "5 - Display"
i_colBsl   = input.color(color.new(#f23645, 0), "Buy-side pool",  group = G5, inline = "c1")
i_colSsl   = input.color(color.new(#089981, 0), "Sell-side pool", group = G5, inline = "c1")
i_colKey   = input.color(color.new(#ff9800, 0), "Key level (PD/PW/session)", group = G5, inline = "c2")
i_colBrk   = input.color(color.new(#787b86, 0), "Break", group = G5, inline = "c2")
i_boxOn    = input.bool(true, "Shade sweep area (level to wick extreme)", group = G5)
i_boxExt   = input.int(20, "Extend sweep area right (bars)", minval = 0, maxval = 200, group = G5)
i_histMax  = input.int(30, "Keep last N swept / broken pools on chart", minval = 0, maxval = 200, group = G5)
i_lblOn    = input.bool(true, "Level labels", group = G5)
i_tblOn    = input.bool(true, "Status table", group = G5)
i_tblPos   = input.string("Top right", "Table position",
     options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G5)
i_tblSize  = input.string("Small", "Table text size", options = ["Tiny", "Small", "Normal"], group = G5)

// =============================================================== TYPES
// One pending (or resolved) liquidity pool.
//   side   +1 = buy-side (above price, swing high family)   -1 = sell-side
//   kind   "SH" "EQH" "PDH" "PWH" "ASIA-H" "LON-H" "NY-H"  (mirror: SL EQL PDL ...)
//   state   0 = pending, 1 = penetrated (candidate open), 2 = swept, 3 = broken
type Pool
    float  price
    int    side
    string kind
    int    touches
    int    startBar
    int    state
    int    penBar
    float  extreme
    int    closesBeyond
    line   ln
    label  lb
    box    bx
    label  ev

// =============================================================== GLOBAL SERIES
// Every ta.* call sits at global scope (v6 evaluates and/or lazily inside blocks).
atr      = ta.atr(14)
ph       = ta.pivothigh(high, i_swL, i_swR)
pl       = ta.pivotlow(low, i_swL, i_swR)
eqTol    = i_tolMode == "USD" ? i_tolUsd : i_tolAtr * nz(atr, i_tolUsd)

// Calendar day / week in the trading-day timezone (NOT the feed's daily bar).
dayId    = year(time, i_tz) * 10000 + month(time, i_tz) * 100 + dayofmonth(time, i_tz)
weekId   = year(time, i_tz) * 100 + weekofyear(time, i_tz)
newDay   = not na(dayId[1]) and dayId != dayId[1]
newWeek  = not na(weekId[1]) and weekId != weekId[1]

// Sessions resolve in their own IANA zone so DST is right for each venue.
inAsia   = not na(time(timeframe.period, i_asiaSess, "Asia/Tokyo"))
inLon    = not na(time(timeframe.period, i_lonSess, "Europe/London"))
inNy     = not na(time(timeframe.period, i_nySess, "America/New_York"))
asiaEnd  = inAsia[1] and not inAsia
lonEnd   = inLon[1] and not inLon
nyEnd    = inNy[1] and not inNy

// Running extremes for the current day / week / session.
var float dHi = na
var float dLo = na
var float wHi = na
var float wLo = na
var float aHi = na
var float aLo = na
var float lHi = na
var float lLo = na
var float nHi = na
var float nLo = na
// Completed values published on the boundary bar.
float pdh = na
float pdl = na
float pwh = na
float pwl = na
float ash = na
float asl = na
float lnh = na
float lnl = na
float nyh = na
float nyl = na

if newDay
    pdh := dHi
    pdl := dLo
    dHi := high
    dLo := low
else
    dHi := math.max(nz(dHi, high), high)
    dLo := math.min(nz(dLo, low), low)
if newWeek
    pwh := wHi
    pwl := wLo
    wHi := high
    wLo := low
else
    wHi := math.max(nz(wHi, high), high)
    wLo := math.min(nz(wLo, low), low)
if asiaEnd
    ash := aHi
    asl := aLo
    aHi := na
    aLo := na
else if inAsia
    aHi := math.max(nz(aHi, high), high)
    aLo := math.min(nz(aLo, low), low)
if lonEnd
    lnh := lHi
    lnl := lLo
    lHi := na
    lLo := na
else if inLon
    lHi := math.max(nz(lHi, high), high)
    lLo := math.min(nz(lLo, low), low)
if nyEnd
    nyh := nHi
    nyl := nLo
    nHi := na
    nLo := na
else if inNy
    nHi := math.max(nz(nHi, high), high)
    nLo := math.min(nz(nLo, low), low)

// =============================================================== REGISTRY
var array<Pool> pools   = array.new<Pool>()   // pending + penetrated
var array<Pool> history = array.new<Pool>()   // swept / broken, capped at i_histMax

// Event flags for plotshape / alerts. Reset every bar, set on confirmed bars only.
bool evBslSweep = false
bool evSslSweep = false
bool evBslBreak = false
bool evSslBreak = false
// Last sweep text / bar. Held in 1-slot arrays because a function cannot assign a global.
var array<string> lastEv    = array.new<string>(1, "none yet")
var array<int>    lastEvBar = array.new<int>(1, na)

f_isKey(string k) =>
    k != "SH" and k != "SL" and k != "EQH" and k != "EQL"

f_color(Pool p) =>
    p.state == 3 ? i_colBrk : f_isKey(p.kind) ? i_colKey : p.side == 1 ? i_colBsl : i_colSsl

f_labelText(Pool p) =>
    string base = p.kind
    string t = p.touches > 1 ? base + " x" + str.tostring(p.touches) : base
    t + "  " + str.tostring(p.price, format.mintick)

f_redraw(Pool p) =>
    color c = f_color(p)
    bool eq = p.touches > 1
    line.set_y1(p.ln, p.price)
    line.set_y2(p.ln, p.price)
    line.set_color(p.ln, c)
    line.set_width(p.ln, (eq or f_isKey(p.kind)) ? 2 : 1)
    line.set_style(p.ln, p.state >= 2 ? line.style_solid : line.style_dashed)
    if not na(p.lb)
        label.set_y(p.lb, p.price)
        label.set_text(p.lb, f_labelText(p))
        label.set_textcolor(p.lb, c)

f_delete(Pool p) =>
    line.delete(p.ln)
    if not na(p.lb)
        label.delete(p.lb)
    if not na(p.bx)
        box.delete(p.bx)
    if not na(p.ev)
        label.delete(p.ev)

f_create(float price, int side, string kind, int startBar) =>
    color c = f_isKey(kind) ? i_colKey : side == 1 ? i_colBsl : i_colSsl
    line ln = line.new(startBar, price, bar_index, price, xloc.bar_index, extend.right, c,
         line.style_dashed, f_isKey(kind) ? 2 : 1)
    label lb = na
    if i_lblOn
        lb := label.new(bar_index, price, kind + "  " + str.tostring(price, format.mintick),
             xloc.bar_index, yloc.price, color.new(color.black, 100),
             label.style_label_left, c, size.small)
    Pool p = Pool.new(price, side, kind, 1, startBar, 0, na, na, 0, ln, lb, na, na)
    array.push(pools, p)
    p

// Remove every pending pool of a given kind (used when a key level rolls over).
f_dropKind(string kind) =>
    if array.size(pools) > 0
        for i = array.size(pools) - 1 to 0
            Pool p = array.get(pools, i)
            if p.kind == kind and p.state == 0
                f_delete(p)
                array.remove(pools, i)

// Count pending SWING pools on a side (key levels are not capped, so they are not counted).
f_countSide(int side) =>
    int n = 0
    for p in pools
        if p.side == side and p.state == 0 and not f_isKey(p.kind)
            n += 1
    n

// Drop the OLDEST pending swing pool on a side (key levels are never evicted this way).
f_evictOldest(int side) =>
    int idx = -1
    int oldest = bar_index + 1
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            Pool p = array.get(pools, i)
            if p.side == side and p.state == 0 and not f_isKey(p.kind) and p.startBar < oldest
                oldest := p.startBar
                idx := i
    if idx >= 0
        f_delete(array.get(pools, idx))
        array.remove(pools, idx)

// Add a swing; merge into an existing pool of the same side within tolerance
// (taking the EXTREME price) when EQ clustering is on. Returns nothing useful.
f_addSwing(float price, int side, int startBar) =>
    bool merged = false
    if i_eqOn
        for p in pools
            if not merged and p.side == side and p.state == 0 and not f_isKey(p.kind) and
                 math.abs(p.price - price) <= eqTol
                p.price := side == 1 ? math.max(p.price, price) : math.min(p.price, price)
                p.touches += 1
                p.kind := side == 1 ? "EQH" : "EQL"
                f_redraw(p)
                merged := true
    if not merged
        while f_countSide(side) >= i_maxSide
            f_evictOldest(side)
        f_create(price, side, side == 1 ? "SH" : "SL", startBar)
    merged

// =============================================================== PER-BAR ENGINE
// Everything below mutates state on CONFIRMED bars only, so nothing repaints.
f_resolve(Pool p, int newState) =>
    // Finish the line at this bar, restyle, print the event, move to history.
    p.state := newState
    line.set_x2(p.ln, bar_index)
    line.set_extend(p.ln, extend.none)
    f_redraw(p)
    bool sweep = newState == 2
    string sideTxt = p.side == 1 ? "BSL" : "SSL"
    float depth = math.abs(p.extreme - p.price)
    int barsHeld = bar_index - p.penBar + 1
    string txt = sweep ? sideTxt + " SWEPT" : sideTxt + " BREAK"
    string tip = txt + "\nPool: " + p.kind + (p.touches > 1 ? " x" + str.tostring(p.touches) : "") +
         " @ " + str.tostring(p.price, format.mintick) +
         "\nWick extreme: " + str.tostring(p.extreme, format.mintick) +
         "\nDepth beyond level: " + str.tostring(depth, "#.##") + " USD" +
         "\nResolved in " + str.tostring(barsHeld) + " bar(s)"
    color c = sweep ? (p.side == 1 ? i_colBsl : i_colSsl) : i_colBrk
    if sweep or i_showBrk
        // Event label at the wick extreme, pointing back toward the level.
        p.ev := label.new(bar_index, p.extreme, txt, xloc.bar_index, yloc.price,
             sweep ? color.new(c, 15) : color.new(c, 60),
             p.side == 1 ? label.style_label_down : label.style_label_up,
             color.white, size.small, text.align_center, tip)
    if sweep and i_boxOn
        float top = p.side == 1 ? p.extreme : p.price
        float bot = p.side == 1 ? p.price : p.extreme
        p.bx := box.new(p.penBar, top, bar_index + i_boxExt, bot, color.new(c, 55), 1,
             line.style_dotted, extend.none, xloc.bar_index, color.new(c, 85))
    if sweep
        array.set(lastEv, 0, txt + " " + p.kind + " @ " + str.tostring(p.price, format.mintick))
        array.set(lastEvBar, 0, bar_index)
    if sweep or i_showBrk
        array.push(history, p)
    else
        // Breaks the user does not want to see: drop the drawing, keep nothing.
        f_delete(p)
    while array.size(history) > i_histMax
        Pool old = array.shift(history)
        f_delete(old)
    newState

f_rollKey(bool on, bool boundary, float hi, float lo, string kindH, string kindL) =>
    if on and boundary and not na(hi) and not na(lo)
        f_dropKind(kindH)
        f_create(hi, 1, kindH, bar_index)
        f_dropKind(kindL)
        f_create(lo, -1, kindL, bar_index)
    on

if barstate.isconfirmed
    // ---- 1. New confirmed swings (the pivot bar is i_swR bars back).
    if not na(ph)
        f_addSwing(ph, 1, bar_index - i_swR)
    if not na(pl)
        f_addSwing(pl, -1, bar_index - i_swR)

    // ---- 2. Key levels roll over on their boundary bar. A pool of the same kind
    //         that is still pending is replaced; one already penetrated keeps running.
    f_rollKey(i_pdOn,   newDay,  pdh, pdl, "PDH",    "PDL")
    f_rollKey(i_pwOn,   newWeek, pwh, pwl, "PWH",    "PWL")
    f_rollKey(i_asiaOn, asiaEnd, ash, asl, "ASIA-H", "ASIA-L")
    f_rollKey(i_lonOn,  lonEnd,  lnh, lnl, "LON-H",  "LON-L")
    f_rollKey(i_nyOn,   nyEnd,   nyh, nyl, "NY-H",   "NY-L")

    // ---- 3. Sweep / break state machine over every pool.
    if array.size(pools) > 0
        for i = array.size(pools) - 1 to 0
            Pool p = array.get(pools, i)
            int d = p.side
            float probe = d == 1 ? high : low
            float pen = (probe - p.price) * d
            bool resolved = false
            if p.state == 0 and pen >= i_minPen
                p.state := 1
                p.penBar := bar_index
                p.extreme := probe
                p.closesBeyond := 0
            if p.state == 1
                p.extreme := d == 1 ? math.max(p.extreme, high) : math.min(p.extreme, low)
                bool closeBeyond = (close - p.price) * d > i_buf
                bool closeInside = (p.price - close) * d > i_buf
                if closeBeyond
                    p.closesBeyond += 1
                int age = bar_index - p.penBar + 1
                if closeInside
                    f_resolve(p, 2)
                    resolved := true
                else if p.closesBeyond >= i_accept
                    f_resolve(p, 3)
                    resolved := true
                else if age >= i_window
                    f_resolve(p, (close - p.price) * d > 0 ? 3 : 2)
                    resolved := true
            if resolved
                if p.state == 2 and d == 1
                    evBslSweep := true
                if p.state == 2 and d == -1
                    evSslSweep := true
                if p.state == 3 and d == 1
                    evBslBreak := true
                if p.state == 3 and d == -1
                    evSslBreak := true
                array.remove(pools, i)
            else if p.state == 0 and bar_index - p.startBar > i_maxAge
                f_delete(p)
                array.remove(pools, i)

// =============================================================== MARKERS
plotshape(evBslSweep, "BSL swept", shape.triangledown, location.abovebar, i_colBsl, 0, "", i_colBsl, false, size.tiny)
plotshape(evSslSweep, "SSL swept", shape.triangleup,   location.belowbar, i_colSsl, 0, "", i_colSsl, false, size.tiny)
plotshape(evBslBreak and i_showBrk, "BSL break", shape.xcross, location.abovebar, i_colBrk, 0, "", i_colBrk, false, size.tiny)
plotshape(evSslBreak and i_showBrk, "SSL break", shape.xcross, location.belowbar, i_colBrk, 0, "", i_colBrk, false, size.tiny)

// =============================================================== LIVE STATUS
// Nearest pending pool on each side and whether the LIVE bar is testing it.
// This part runs on every tick so the table is live; it mutates nothing.
float nearUp = na
string nearUpKind = ""
float nearDn = na
string nearDnKind = ""
int cntUp = 0
int cntDn = 0
bool testUp = false
bool testDn = false
for p in pools
    if p.side == 1
        if p.state == 0
            cntUp += 1
        if p.price >= close and (na(nearUp) or p.price < nearUp)
            nearUp := p.price
            nearUpKind := p.kind + (p.touches > 1 ? " x" + str.tostring(p.touches) : "")
        if p.state == 1 or high >= p.price
            testUp := true
    else
        if p.state == 0
            cntDn += 1
        if p.price <= close and (na(nearDn) or p.price > nearDn)
            nearDn := p.price
            nearDnKind := p.kind + (p.touches > 1 ? " x" + str.tostring(p.touches) : "")
        if p.state == 1 or low <= p.price
            testDn := true

var table tbl = na
if i_tblOn and barstate.islast
    if na(tbl)
        pos = i_tblPos == "Top right" ? position.top_right : i_tblPos == "Top left" ? position.top_left :
             i_tblPos == "Bottom right" ? position.bottom_right : position.bottom_left
        tbl := table.new(pos, 4, 4, color.new(color.black, 20), color.new(color.gray, 60), 1,
             color.new(color.gray, 60), 1)
        table.merge_cells(tbl, 1, 3, 3, 3)
    sz = i_tblSize == "Tiny" ? size.tiny : i_tblSize == "Small" ? size.small : size.normal
    table.cell(tbl, 0, 0, "LIQUIDITY", text_color = color.white, text_size = sz, bgcolor = color.new(color.gray, 40))
    table.cell(tbl, 1, 0, "pending", text_color = color.white, text_size = sz, bgcolor = color.new(color.gray, 40))
    table.cell(tbl, 2, 0, "nearest", text_color = color.white, text_size = sz, bgcolor = color.new(color.gray, 40))
    table.cell(tbl, 3, 0, "status", text_color = color.white, text_size = sz, bgcolor = color.new(color.gray, 40))
    string upTxt = na(nearUp) ? "-" : nearUpKind + " " + str.tostring(nearUp, format.mintick) +
         "  (+" + str.tostring(nearUp - close, "#.##") + ")"
    string dnTxt = na(nearDn) ? "-" : nearDnKind + " " + str.tostring(nearDn, format.mintick) +
         "  (-" + str.tostring(close - nearDn, "#.##") + ")"
    table.cell(tbl, 0, 1, "Buy-side  (above)", text_color = i_colBsl, text_size = sz, text_halign = text.align_left)
    table.cell(tbl, 1, 1, str.tostring(cntUp), text_color = color.white, text_size = sz)
    table.cell(tbl, 2, 1, upTxt, text_color = color.white, text_size = sz, text_halign = text.align_left)
    table.cell(tbl, 3, 1, testUp ? "TESTING NOW" : "waiting", text_color = testUp ? color.white : color.gray,
         text_size = sz, bgcolor = testUp ? color.new(i_colBsl, 30) : na)
    table.cell(tbl, 0, 2, "Sell-side (below)", text_color = i_colSsl, text_size = sz, text_halign = text.align_left)
    table.cell(tbl, 1, 2, str.tostring(cntDn), text_color = color.white, text_size = sz)
    table.cell(tbl, 2, 2, dnTxt, text_color = color.white, text_size = sz, text_halign = text.align_left)
    table.cell(tbl, 3, 2, testDn ? "TESTING NOW" : "waiting", text_color = testDn ? color.white : color.gray,
         text_size = sz, bgcolor = testDn ? color.new(i_colSsl, 30) : na)
    int lastBar = array.get(lastEvBar, 0)
    string ago = na(lastBar) ? "" : "  (" + str.tostring(bar_index - lastBar) + " bars ago)"
    table.cell(tbl, 0, 3, "Last sweep", text_color = color.gray, text_size = sz, text_halign = text.align_left)
    table.cell(tbl, 1, 3, array.get(lastEv, 0) + ago, text_color = color.white, text_size = sz, text_halign = text.align_left)

// =============================================================== ALERTS
// NOTE: TradingView Basic plan allows 0 indicator alerts; Essential or above is needed.
alertcondition(evBslSweep, "BSL swept (bearish raid)", "XAU: buy-side liquidity swept - wick above level, close back inside")
alertcondition(evSslSweep, "SSL swept (bullish raid)", "XAU: sell-side liquidity swept - wick below level, close back inside")
alertcondition(evBslBreak, "BSL broken (close through)", "XAU: buy-side liquidity broken - acceptance above level")
alertcondition(evSslBreak, "SSL broken (close through)", "XAU: sell-side liquidity broken - acceptance below level")
alertcondition(evBslSweep or evSslSweep, "Any sweep", "XAU: liquidity sweep")
if evBslSweep or evSslSweep or (i_showBrk and (evBslBreak or evSslBreak))
    alert("XAU LIQ " + array.get(lastEv, 0) + " | close " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
